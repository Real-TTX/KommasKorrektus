@using KommasKorrektus.Pages.Billing
@model DocIndexModelBase

<div class="mat-grid mat-grid--4">
    <div class="mat-card"><div class="mat-card__body mat-stat"><span class="mat-stat__label">@(Model.Base == "/Offers" ? "Angeboten" : "Gestellt")</span><span class="mat-stat__value">@Fmt.Money(Model.SumGross)</span><span class="mat-stat__delta">brutto, in der Liste unten</span></div></div>
    @if (Model.Base == "/Invoices")
    {
        <div class="mat-card"><div class="mat-card__body mat-stat"><span class="mat-stat__label">Offen</span><span class="mat-stat__value">@Fmt.Money(Model.SumOpen)</span><span class="mat-stat__delta">noch nicht bezahlt</span></div></div>
        <div class="mat-card"><div class="mat-card__body mat-stat"><span class="mat-stat__label">Überfällig</span><span class="mat-stat__value @(Model.Overdue > 0 ? "kk-warn" : "")">@Fmt.Money(Model.SumOverdue)</span><span class="mat-stat__delta">@Ui.Plural(Model.Overdue, "Rechnung", "Rechnungen")</span></div></div>
    }
    <div class="mat-card"><div class="mat-card__body mat-stat"><span class="mat-stat__label">Entwürfe</span><span class="mat-stat__value">@Model.Drafts</span><span class="mat-stat__delta">noch nicht ausgestellt</span></div></div>
</div>

<div class="mat-list">
    <partial name="_Toolbar" model="Model.Toolbar" />
    <partial name="_Table" model="Model.Table" />
    <partial name="_Pager" model="Model.Pager" />
    <div class="mat-actions">
        <a class="mat-btn mat-btn--primary" href="@Model.Base/Edit">@Ui.Icon("plus")<span>@Model.NewLabel</span></a>
    </div>
</div>
