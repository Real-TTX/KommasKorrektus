@using KommasKorrektus.Pages.Billing
@model DocSendModelBase
@{
    var i = Model.Invoice;
    var back = $"{(i.Type == DocType.Offer ? "/Offers" : "/Invoices")}/Details?id={i.Id}";
}

@if (!Model.MailConfigured)
{
    <div class="mat-alert mat-alert--warning">@Ui.Icon("alert")<div class="mat-alert__body">Es ist noch kein E-Mail-Server eingerichtet (Verwaltung > E-Mail). Du kannst das PDF herunterladen, selbst versenden und das Dokument dann als versendet markieren.</div></div>
}

<form class="mat-form" method="post" novalidate>
    <input type="hidden" name="Id" value="@i.Id" />
    <input type="hidden" name="Reminder" value="@(Model.Reminder ? "true" : "false")" />
    <kk-summary />
    <kk-card title="@($"{Labels.Of(i.Type)} {i.Number}")" icon="send" sub="@Fmt.Money(i.GrossTotal, i.Currency)">
        <div class="mat-form__grid">
            <kk-input for="Input.To" label="An" type="email" inputmode="email" full="true" required="true" />
            <kk-input for="Input.Subject" label="Betreff" full="true" required="true" />
            <kk-textarea for="Input.Text" label="Nachricht" rows="10" full="true" required="true" hint="Das PDF wird angehängt@(i.Type == DocType.Offer ? "" : " (die E-Rechnung ist darin enthalten)")." />
        </div>
    </kk-card>
    <kk-buttons save-text="Senden" save-icon="send" back-href="@back" no-save="@(!Model.MailConfigured)" />
</form>
