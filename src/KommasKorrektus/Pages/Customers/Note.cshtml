@page
@using Microsoft.AspNetCore.Mvc.Rendering
@model KommasKorrektus.Pages.Customers.NoteModel
@{
    var kinds = new List<SelectListItem>
    {
        new(Labels.Of(HistoryKind.Note), nameof(HistoryKind.Note)), new(Labels.Of(HistoryKind.Call), nameof(HistoryKind.Call)),
        new(Labels.Of(HistoryKind.Mail), nameof(HistoryKind.Mail)), new(Labels.Of(HistoryKind.Meeting), nameof(HistoryKind.Meeting)),
    };
    var back = $"/Customers/Details?id={Model.CustomerId}&tab=history";
}

<form class="mat-form" method="post" novalidate>
    <input type="hidden" name="CustomerId" value="@Model.CustomerId" />
    <input type="hidden" name="Id" value="@Model.Id" />
    <kk-summary />
    <kk-card title="@Model.Customer.DisplayName" icon="history">
        <div class="mat-form__grid">
            <kk-select for="Input.Kind" label="Art" items="kinds" />
            <kk-input for="Input.Date" label="Datum" type="date" required="true" />
            <kk-input for="Input.Title" label="Überschrift" full="true" required="true" />
            <kk-textarea for="Input.Text" label="Text" rows="6" full="true" />
            @if (Model.Projects.Count > 0)
            {
                <kk-select for="Input.ProjectId" label="Zu welchem Projekt?" items="Model.Projects" empty="(kein bestimmtes)" full="true" />
            }
        </div>
    </kk-card>
    @if (Model.Id is not null)
    {
        <kk-buttons back-href="@back" delete-url="@Url.Page("/Customers/Note", "Delete", new { customerId = Model.CustomerId, id = Model.Id })" delete-confirm="Diese Notiz löschen?" />
    }
    else
    {
        <kk-buttons back-href="@back" />
    }
</form>
