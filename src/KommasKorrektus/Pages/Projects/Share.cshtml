@page
@model KommasKorrektus.Pages.Projects.ShareModel
@{
    var back = $"/Projects/Details?id={Model.ProjectId}&tab=shares";
    var link = Model.Link;
}

@if (link is not null)
{
    <kk-card title="Der Link" icon="link" sub="@(Model.IsActive ? "gültig" : link.RevokedDate is not null ? "zurückgezogen" : "abgelaufen")">
        <div class="mat-field">
            <label class="mat-label" for="share-link">Adresse zum Weitergeben</label>
            <div class="mat-input-group">
                <input class="mat-input mat-mono" id="share-link" readonly value="@Model.LinkUrl" />
                <button type="button" class="mat-btn mat-btn--secondary" data-copy="#share-link">@Ui.Icon("copy")<span>Kopieren</span></button>
            </div>
            <span class="mat-hint">Gültig bis @Fmt.Moment(link.ExpiresDate) · @link.ViewCount Aufrufe@(link.LastViewDate is null ? "" : $", zuletzt {Fmt.Moment(link.LastViewDate)}")@(link.ApprovedDate is null ? "" : $" · freigegeben von {link.ApprovedByName} am {Fmt.Date(link.ApprovedDate)}")@(link.PasswordHash is null ? "" : " · mit Passwort")@(link.UserId is null ? "" : " · nur für " + (Model.Accounts.FirstOrDefault(a => a.Value == link.UserId.ToString())?.Text ?? "ein Konto"))</span>
        </div>
        <form method="post" class="mat-actions">
            <a class="mat-btn mat-btn--secondary" href="@Model.LinkUrl" target="_blank" rel="noopener">@Ui.Icon("external")<span>So sieht es das Gegenüber</span></a>
            <button type="submit" asp-page-handler="Send" asp-route-projectId="@Model.ProjectId" asp-route-id="@link.Id" class="mat-btn mat-btn--secondary" data-tip="@(Model.MailConfigured ? "Den Link per E-Mail senden" : "Es ist kein E-Mail-Server eingerichtet")">@Ui.Icon("send")<span>Per E-Mail senden</span></button>
            @if (link.RevokedDate is null)
            {
                <button type="submit" asp-page-handler="Revoke" asp-route-projectId="@Model.ProjectId" asp-route-id="@link.Id" class="mat-btn mat-btn--ghost" data-confirm="Den Link zurückziehen? Wer ihn hat, sieht danach nichts mehr." data-confirm-ok="Zurückziehen">@Ui.Icon("lock")<span>Zurückziehen</span></button>
            }
        </form>
    </kk-card>
}

<form class="mat-form" method="post" novalidate>
    <input type="hidden" name="ProjectId" value="@Model.ProjectId" />
    <input type="hidden" name="Id" value="@Model.Id" />
    <kk-summary />
    <kk-card title="Was wird geteilt?" icon="share">
        <div class="mat-form__grid">
            <kk-input for="Input.Title" label="Titel" full="true" required="true" hint="Steht oben auf der Seite, die das Gegenüber sieht." />
            <kk-select for="Input.DocumentId" label="Umfang" items="Model.Documents" empty="Das ganze Projekt: alle Dokumente" full="true" />
            <kk-input for="Input.VersionNo" label="Feste Fassung (Nummer)" type="number" min="1" hint="Leer: immer die neueste. Nur bei einem einzelnen Dokument." show-if="Input.DocumentId" />
            <kk-textarea for="Input.Message" label="Nachricht" rows="3" full="true" hint="Erscheint auf der Seite und in der E-Mail." />
        </div>
    </kk-card>

    <kk-card title="Für wen?" icon="user">
        <div class="mat-form__grid">
            <kk-select for="Input.UserId" label="Konto" items="Model.Accounts" empty="Für alle mit dem Link (anonym)" full="true" hint="Mit einem Konto ist die Freigabe nur für dieses Konto: es meldet sich an und findet sie unter „Mit mir geteilt“, wer sonst den Link hat, sieht nichts. Ohne Konto kann jeder mit dem Link hinein." />
        </div>
    </kk-card>

    <kk-card title="Was darf das Gegenüber?" icon="key">
        <div class="mat-form__grid">
            <kk-switch for="Input.ShowChanges" label="Die Änderungen sehen (alt und neu)" full="true" />
            <kk-switch for="Input.AllowDownload" label="Dokumente herunterladen (Word und PDF)" full="true" />
            <kk-switch for="Input.AllowComments" label="Kommentare schreiben" full="true" />
            <kk-switch for="Input.AllowApproval" label="Die Änderungen freigeben („passt so“)" full="true" />
        </div>
    </kk-card>

    <kk-card title="Gültigkeit und Schutz" icon="lock">
        <div class="mat-form__grid">
            <kk-input for="Input.Days" label="Gültig für Tage" type="number" min="1" max="365" hint="@(link is null ? "Danach funktioniert der Link nicht mehr." : "Neu gerechnet ab jetzt.")" />
            <kk-input for="Input.Password" label="Passwort (optional)" type="password" autocomplete="new-password" show-if="Input.UserId" show-value="" hint="@(link?.PasswordHash is null ? "Ohne Passwort kann jeder mit dem Link hinein." : "Leer lassen, um das Passwort zu behalten.")" />
        </div>
    </kk-card>

    <kk-card title="Empfänger" icon="mail">
        <div class="mat-form__grid">
            <kk-input for="Input.RecipientName" label="Name" />
            <kk-input for="Input.RecipientEmail" label="E-Mail-Adresse" type="email" inputmode="email" />
            @if (link is null && Model.MailConfigured)
            {
                <kk-switch for="Input.SendNow" label="Gleich per E-Mail senden" full="true" hint="Die Empfängerin oder der Empfänger bekommt den Link sofort, mit deiner Nachricht. Mit einem Konto steht die Freigabe auch unter „Mit mir geteilt“." />
            }
        </div>
    </kk-card>

    @if (link is not null)
    {
        <kk-buttons back-href="@back" delete-url="@Url.Page("/Projects/Share", "Delete", new { projectId = Model.ProjectId, id = link.Id })" delete-confirm="Diesen Link mit seinem Protokoll löschen?" />
    }
    else
    {
        <kk-buttons back-href="@back" save-text="Link erstellen" save-icon="link" />
    }
</form>

@if (link is not null)
{
    <kk-card title="Was mit dem Link passiert ist" icon="activity">
        @if (Model.Accesses.Count == 0)
        {
            <p class="mat-muted">Der Link wurde noch nicht benutzt.</p>
        }
        else
        {
            <div class="mat-table-wrap">
                <table class="mat-table" id="share-accesses">
                    <caption class="mat-sr-only">Nutzung des Links</caption>
                    <thead><tr><th scope="col">Wann</th><th scope="col">Was</th><th scope="col" class="mat-hide-sm">Besucher</th><th scope="col" class="mat-hide-sm">Gerät</th></tr></thead>
                    <tbody>
                        @foreach (var a in Model.Accesses)
                        {
                            <tr>
                                <td data-label="Wann">@Fmt.Moment(a.AccessDate)</td>
                                <td data-label="Was">@(a.Action switch { ShareAction.View => "Angesehen", ShareAction.Download => "Heruntergeladen", ShareAction.Comment => "Kommentiert", ShareAction.Approve => "Freigegeben", _ => "Falsches Passwort" })@(string.IsNullOrWhiteSpace(a.Detail) ? "" : ": " + a.Detail)</td>
                                <td data-label="Besucher" class="mat-hide-sm @(a.UserId is null ? "mat-mono" : "")">@(a.UserId is { } visitor && Model.VisitorNames.TryGetValue(visitor, out var visitorName) ? visitorName : a.ClientHash)</td>
                                <td data-label="Gerät" class="mat-hide-sm">@KommasKorrektus.Pages.Account.SecurityModel.DeviceName(a.UserAgent)</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </kk-card>
}
