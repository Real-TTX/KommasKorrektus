@page
@model KommasKorrektus.Pages.Admin.SystemModel

<div class="mat-grid mat-grid--3">
    <div class="mat-card"><div class="mat-card__body mat-stat"><span class="mat-stat__label">Version</span><span class="mat-stat__value mat-mono">@Model.Version</span><span class="mat-stat__delta">seit @Fmt.Moment(Model.Started) in Betrieb</span></div></div>
    <div class="mat-card"><div class="mat-card__body mat-stat"><span class="mat-stat__label">Datenbank</span><span class="mat-stat__value">@Fmt.FileSize(Model.DatabaseBytes)</span><span class="mat-stat__delta">@Model.DatabaseVersion</span></div></div>
    <div class="mat-card"><div class="mat-card__body mat-stat"><span class="mat-stat__label">Arbeitsspeicher</span><span class="mat-stat__value">@Fmt.FileSize(Model.Memory)</span><span class="mat-stat__delta">der Anwendung</span></div></div>
</div>

<div class="mat-grid mat-grid--2">
    <kk-card title="Anwendung" icon="server">
        <dl class="mat-kv">
            <dt>Laufzeit</dt><dd>@Model.Runtime</dd>
            <dt>System</dt><dd>@Model.Os (@Model.Architecture)</dd>
            <dt>Zeitzone</dt><dd>@Model.TimeZone</dd>
            <dt>Datenordner</dt><dd class="mat-mono">@Model.DataDir</dd>
            <dt>E-Mail</dt><dd>@(Model.MailConfigured ? "eingerichtet" : "nicht eingerichtet") · <a href="/Admin/Mail">ändern</a></dd>
            <dt>Dateispeicher</dt><dd>@(Model.Storage == KommasKorrektus.Configuration.StorageMode.Smb ? "NAS (SMB)" : "Volume") · <a href="/Admin/Storage">ändern</a></dd>
            <dt>Sicherung</dt><dd>@(Model.BackupBusy ? "läuft gerade" : "bereit") · <a href="/Admin/Backup">öffnen</a></dd>
        </dl>
    </kk-card>

    <kk-card title="Inhalt" icon="database">
        <dl class="mat-kv">
            @foreach (var (name, count) in Model.Counts)
            {
                <dt>@name</dt><dd>@Fmt.Integer(count)</dd>
            }
        </dl>
    </kk-card>
</div>

<kk-card title="Datenordner" icon="folder">
    <div class="mat-table-wrap">
        <table class="mat-table" id="data-folders">
            <caption class="mat-sr-only">Belegung des Datenordners</caption>
            <thead><tr><th scope="col">Ordner</th><th scope="col" class="mat-hide-sm">Wofür</th><th scope="col" class="mat-num">Dateien</th><th scope="col" class="mat-num">Größe</th></tr></thead>
            <tbody>
                @foreach (var f in Model.Folders)
                {
                    <tr>
                        <td data-label="Ordner">@f.Name</td>
                        <td data-label="Wofür" class="mat-hide-sm">@f.Hint</td>
                        <td data-label="Dateien" class="mat-num">@Fmt.Integer(f.Files)</td>
                        <td data-label="Größe" class="mat-num">@Fmt.FileSize(f.Bytes)</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</kk-card>

<kk-card title="Aufräumen" icon="refresh">
    <p class="mat-muted">Einmal am Tag entfernt KommasKorrektus beendete Sitzungen, benutzte Codes und Protokolle, die älter als ein Jahr sind. Du kannst das auch jetzt tun.</p>
    <form method="post" class="mat-actions">
        <button type="submit" asp-page-handler="Maintain" class="mat-btn mat-btn--secondary">@Ui.Icon("refresh")<span>Jetzt aufräumen</span></button>
    </form>
</kk-card>
