@page
@model KommasKorrektus.Pages.IndexModel
@{
    var doneSteps = Model.Steps.Count(s => s.Done);
}

@if (Model.Steps.Count > 0 && doneSteps < Model.Steps.Count)
{
    <kk-card title="Erste Schritte" icon="rocket" sub="@($"{doneSteps} von {Model.Steps.Count} erledigt")">
        <ul class="mat-listgroup mat-listgroup--flush">
            @foreach (var step in Model.Steps)
            {
                <li><a class="mat-listgroup__item" href="@step.Href">@Ui.Icon(step.Done ? "check-circle" : "clock")<span class="mat-listgroup__text"><strong>@step.Title</strong><small>@step.Text</small></span>@if (step.Done) { <span class="mat-pill mat-pill--ok">Erledigt</span> }</a></li>
            }
        </ul>
    </kk-card>
}

<div class="mat-grid mat-grid--4">
    <div class="mat-card"><div class="mat-card__body"><div class="mat-muted">Laufende Projekte</div><h2>@Model.ActiveProjects</h2><small class="mat-muted"><a href="/Projects">alle Projekte</a></small></div></div>
    <div class="mat-card"><div class="mat-card__body"><div class="mat-muted">Offene Aufgaben</div><h2>@Model.OpenTasks</h2><small class="@(Model.OverdueTasks > 0 ? "kk-warn" : "mat-muted")">@(Model.OverdueTasks > 0 ? $"{Model.OverdueTasks} überfällig" : "nichts überfällig")</small></div></div>
    <div class="mat-card"><div class="mat-card__body"><div class="mat-muted">Offene Rechnungen</div><h2>@Fmt.Money(Model.OpenAmount)</h2><small class="@(Model.OverdueInvoices > 0 ? "kk-warn" : "mat-muted")">@(Model.OverdueInvoices > 0 ? $"{Model.OverdueInvoices} überfällig" : "nichts überfällig")</small></div></div>
    <div class="mat-card"><div class="mat-card__body"><div class="mat-muted">Diese Woche gearbeitet</div><h2>@Fmt.Duration(Model.WeekSeconds)</h2><small class="mat-muted">@Fmt.Integer(Model.WeekWords) Wörter bearbeitet</small></div></div>
</div>

<div class="mat-grid mat-grid--2">
    <kk-card title="Fristen der nächsten 7 Tage" icon="calendar">
        @if (Model.DueProjects.Count == 0 && Model.DueTasks.Count == 0)
        {
            <p class="mat-muted">Nichts in den nächsten Tagen. Zeit zum Lektorieren!</p>
        }
        else
        {
            <ul class="mat-listgroup mat-listgroup--flush">
                @foreach (var p in Model.DueProjects)
                {
                    <li><a class="mat-listgroup__item" href="/Projects/Details?id=@p.Id">@Ui.Icon("folder")<span class="mat-listgroup__text"><strong>@p.Title</strong><small>@p.Customer?.DisplayName</small></span><span class="mat-pill @(p.DueDate < Model.Today ? "mat-pill--error" : "")">@Fmt.Date(p.DueDate)</span></a></li>
                }
                @foreach (var t in Model.DueTasks)
                {
                    <li><a class="mat-listgroup__item" href="/Projects/Details?id=@t.ProjectId&tab=tasks">@Ui.Icon("check-square")<span class="mat-listgroup__text"><strong>@t.Title</strong><small>@t.Project?.Title</small></span><span class="mat-pill @(t.DueDate < Model.Today ? "mat-pill--error" : "")">@Fmt.Date(t.DueDate)</span></a></li>
                }
            </ul>
        }
    </kk-card>

    <kk-card title="Offene Rechnungen" icon="dollar">
        @if (Model.OpenInvoices.Count == 0)
        {
            <p class="mat-muted">Keine offenen Rechnungen.</p>
        }
        else
        {
            <ul class="mat-listgroup mat-listgroup--flush">
                @foreach (var i in Model.OpenInvoices)
                {
                    <li><a class="mat-listgroup__item" href="/Invoices/Details?id=@i.Id">@Ui.Icon("receipt")<span class="mat-listgroup__text"><strong>@i.Number</strong><small>@i.Customer?.DisplayName</small></span><span class="mat-pill @(i.DueDate < Model.Today ? "mat-pill--error" : "")">@Fmt.Money(i.GrossTotal - i.PaidTotal)</span></a></li>
                }
            </ul>
        }
    </kk-card>
</div>
