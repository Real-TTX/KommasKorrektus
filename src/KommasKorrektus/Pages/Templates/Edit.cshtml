@page
@model KommasKorrektus.Pages.Templates.EditModel
@{
    var previewUrl = Url.Page("/Templates/Edit", "Preview", new { id = Model.Id });
}

<div class="kk-split">
    <form class="mat-form kk-split__form" method="post" enctype="multipart/form-data" novalidate id="template-form" data-preview-url="@previewUrl">
        <input type="hidden" name="Id" value="@Model.Id" />
        <kk-summary />

        <kk-tabs id="template" label="Vorlage">
            <kk-tab id="general" title="Allgemein" icon="settings">
                <kk-card>
                    <div class="mat-form__grid">
                        <kk-input for="Name" label="Name der Vorlage" full="true" required="true" />
                        <kk-switch for="IsDefault" label="Neue Dokumente beginnen mit dieser Vorlage" full="true" />
                        <kk-select for="Settings.PaperSize" label="Papier" items="KommasKorrektus.Pages.Templates.EditModel.Papers" />
                        <kk-input for="Settings.MarginMm" label="Rand in mm" type="number" min="10" max="35" />
                    </div>
                </kk-card>
            </kk-tab>

            <kk-tab id="look" title="Aussehen" icon="palette">
                <kk-card>
                    <div class="mat-form__grid">
                        <div class="mat-field">
                            <label class="mat-label" for="Settings_AccentColor">Farbe</label>
                            <div class="mat-picker" data-picker="colour">
                                <input class="mat-picker__input" id="Settings_AccentColor" name="Settings.AccentColor" value="@Model.Settings.AccentColor" />
                            </div>
                            <span class="mat-hint">Titel, Linien und Tabellenkopf.</span>
                        </div>
                        <kk-select for="Settings.FontFamily" label="Schrift" items="KommasKorrektus.Pages.Templates.EditModel.Fonts" />
                        <kk-input for="Settings.FontSize" label="Schriftgröße in Punkt" type="number" min="8" max="13" step="0.5" />
                        <kk-switch for="Settings.ShowPageNumbers" label="Seitenzahlen" />
                    </div>
                </kk-card>
            </kk-tab>

            <kk-tab id="logo" title="Logo und Titel" icon="image">
                <kk-card>
                    <div class="mat-form__grid">
                        @if (Model.LogoFileId is not null && Model.Id is not null)
                        {
                            <div class="mat-field mat-field--full">
                                <span class="mat-label">Aktuelles Logo</span>
                                <img class="kk-logo-preview" src="@Url.Page("/Templates/Edit", "Logo", new { id = Model.Id })" alt="Das Logo dieser Vorlage" />
                                <kk-switch for="RemoveLogo" label="Logo entfernen" />
                            </div>
                        }
                        <div class="mat-field mat-field--full">
                            <label class="mat-label" for="LogoFile">@(Model.LogoFileId is null ? "Logo hochladen" : "Anderes Logo hochladen")</label>
                            <input class="mat-input" type="file" id="LogoFile" name="LogoFile" accept=".png,.jpg,.jpeg,.svg,image/png,image/jpeg,image/svg+xml" />
                            <span class="mat-hint">PNG, JPEG oder SVG, bis 2 MB.</span>
                            <span class="mat-error">@(ViewData.ModelState.TryGetValue("LogoFile", out var logoError) && logoError.Errors.Count > 0 ? logoError.Errors[0].ErrorMessage : "")</span>
                        </div>
                        <kk-select for="Settings.LogoPosition" label="Position des Logos" items="KommasKorrektus.Pages.Templates.EditModel.Positions" />
                        <kk-input for="Settings.LogoHeightMm" label="Höhe des Logos in mm" type="number" min="8" max="40" />
                        <kk-input for="Settings.TitleOffer" label="Titel eines Angebots" />
                        <kk-input for="Settings.TitleInvoice" label="Titel einer Rechnung" />
                        <kk-input for="Settings.TitleCreditNote" label="Titel einer Gutschrift" />
                        <kk-switch for="Settings.ShowSenderLine" label="Absenderzeile über der Anschrift" full="true" />
                    </div>
                </kk-card>
            </kk-tab>

            <kk-tab id="table" title="Tabelle" icon="table">
                <kk-card>
                    <div class="mat-form__grid">
                        <kk-switch for="Settings.ShowQuantityColumn" label="Spalte Menge" />
                        <kk-switch for="Settings.ShowUnitColumn" label="Spalte Einheit" />
                        <kk-switch for="Settings.ShowVatColumn" label="Spalte Umsatzsteuer" />
                        <kk-switch for="Settings.ShowDiscountColumn" label="Spalte Rabatt" />
                    </div>
                </kk-card>
            </kk-tab>

            <kk-tab id="texts" title="Zahlung und Fuß" icon="receipt">
                <kk-card>
                    <div class="mat-form__grid">
                        <kk-switch for="Settings.ShowBankDetails" label="Bankverbindung auf Rechnungen" />
                        <kk-switch for="Settings.ShowPaymentQr" label="QR-Code zum Bezahlen (GiroCode)" />
                        <kk-textarea for="Settings.InvoiceNote" label="Zusatztext auf Rechnungen" rows="3" full="true" hint="Zum Beispiel ein Hinweis zur Aufbewahrung oder zu Skonto." />
                        <kk-textarea for="Settings.FooterNote" label="Text in der Fußzeile" rows="2" full="true" />
                    </div>
                </kk-card>
            </kk-tab>
        </kk-tabs>

        @if (Model.Id is not null)
        {
            <kk-buttons back-href="/Templates" delete-url="@Url.Page("/Templates/Edit", "Delete", new { id = Model.Id })" delete-confirm="Diese Vorlage löschen? Ausgestellte Dokumente bleiben unverändert." />
        }
        else
        {
            <kk-buttons back-href="/Templates" />
        }
    </form>

    <aside class="kk-split__preview" aria-label="Vorschau">
        <div class="mat-card">
            <div class="mat-card__head">@Ui.Icon("eye")<span class="mat-card__title">Vorschau</span><span class="mat-card__sub" id="preview-state">aktuell</span></div>
            <div class="mat-card__body kk-preview">
                <iframe id="preview-frame" title="Vorschau der Vorlage als PDF" class="kk-preview__frame"></iframe>
                <p class="mat-hint">Ein Beispiel mit deinen Firmendaten. <a href="#" id="preview-open" target="_blank" rel="noopener">Als PDF in einem neuen Tab öffnen</a></p>
            </div>
        </div>
    </aside>
</div>

@section Scripts {
    <script src="~/js/preview.js" asp-append-version="true"></script>
}
