@page
@model KommasKorrektus.Pages.Documents.EditorModel
@{
    var d = Model.Document;
}

<div class="kk-editor" id="kk-editor">
    @Html.AntiForgeryToken()
    <script type="application/json" id="editor-data">@Html.Raw(Model.DataJson)</script>

    <div class="kk-editor__bar mat-card">
        <div class="kk-editor__head">
            <div class="kk-editor__title">
                <h1>@d.Title</h1>
                <p class="mat-muted"><a href="/Projects/Details?id=@d.ProjectId&tab=documents">@d.Project!.Title</a> · <span id="editor-version">Fassung @Model.Version.VersionNo · @Model.VersionTitle@(Model.Version.Origin switch { VersionOrigin.Working => " · in Arbeit", VersionOrigin.Manual => " · abgeschlossen", _ => "" })</span> · <span id="editor-words">0</span> Wörter</p>
            </div>
            <div class="kk-editor__state">
                <span id="editor-status" class="kk-editor__status is-saved" aria-live="polite" role="status">Geöffnet</span>
                <small class="mat-muted" id="editor-session"></small>
            </div>
        </div>
        <div class="kk-editor__actions">
            <div class="mat-seg" role="group" aria-label="Ansicht">
                <button type="button" class="mat-seg__btn" data-view="text" aria-pressed="true" data-tip="Nur der Text (Alt+W)">@Ui.Icon("type")<span>Text</span></button>
                <button type="button" class="mat-seg__btn" data-view="page" aria-pressed="false" disabled data-tip="Die Seite wie im Original (Alt+W)">@Ui.Icon("file")<span>Seite</span></button>
            </div>
            <button type="button" class="mat-btn mat-btn--primary" id="editor-save" data-tip="Speichern: die Fassung bleibt in Arbeit (Strg+S)">@Ui.Icon("save")<span>Speichern</span></button>
            <button type="button" class="mat-btn mat-btn--secondary" id="editor-close" data-tip="Den Durchgang beenden (Alt+A)">@Ui.Icon("check-circle")<span>Durchgang abschließen</span></button>
            <span class="kk-editor__sep" aria-hidden="true"></span>
            <button type="button" class="mat-btn mat-btn--ghost mat-btn--icon" id="editor-undo" aria-label="Rückgängig (Strg+Z)" data-tip="Rückgängig" disabled>@Ui.Icon("undo")</button>
            <button type="button" class="mat-btn mat-btn--ghost mat-btn--icon" id="editor-redo" aria-label="Wiederholen (Strg+Y)" data-tip="Wiederholen" disabled>@Ui.Icon("redo")</button>
            <button type="button" class="mat-btn mat-btn--ghost mat-btn--icon" id="editor-find" aria-pressed="false" aria-label="Suchen und ersetzen (Strg+H)" data-tip="Suchen und ersetzen (Strg+H)">@Ui.Icon("search")</button>
            <button type="button" class="mat-btn mat-btn--ghost mat-btn--icon" id="editor-side-toggle" aria-pressed="false" aria-label="Kommentare und Stilblatt (Alt+L)" data-tip="Kommentare und Stilblatt (Alt+L)">@Ui.Icon("message-square")<span class="mat-badge mat-badge--soft" id="comment-count">0</span></button>
            <button type="button" class="mat-btn mat-btn--ghost mat-btn--icon" id="editor-focus" aria-pressed="false" aria-label="Vollbild: Menü und Kopfzeile ausblenden (Alt+V)" data-tip="Vollbild: mehr Platz zum Schreiben (Alt+V)"><span data-focus-icon="off">@Ui.Icon("maximize")</span><span data-focus-icon="on" hidden>@Ui.Icon("minimize")</span></button>
            <button type="button" class="mat-btn mat-btn--ghost mat-btn--icon" id="editor-export" data-menu-toggle="editor-export-menu" aria-haspopup="menu" aria-expanded="false" aria-label="Exportieren (Alt+X)" data-tip="Exportieren (Alt+X)">@Ui.Icon("download")</button>
            <button type="button" class="mat-btn mat-btn--ghost mat-btn--icon" id="editor-more" data-menu-toggle="editor-more-menu" aria-haspopup="menu" aria-expanded="false" aria-label="Mehr" data-tip="Mehr">@Ui.Icon("more-vertical")</button>
        </div>

        <div class="kk-find" id="editor-find-bar" role="search" aria-label="Suchen und ersetzen" hidden>
            <div class="kk-find__fields">
                <input class="mat-input mat-input--sm" id="replace-find" placeholder="Suchen" aria-label="Suchen" autocomplete="off" />
                <input class="mat-input mat-input--sm" id="replace-with" placeholder="Ersetzen durch" aria-label="Ersetzen durch" autocomplete="off" />
            </div>
            <div class="kk-find__buttons">
                <button type="button" class="mat-btn mat-btn--ghost mat-btn--icon mat-btn--sm" id="replace-prev" aria-label="Voriger Treffer (Umschalt+F3)" data-tip="Voriger Treffer (Umschalt+F3)">@Ui.Icon("arrow-up")</button>
                <button type="button" class="mat-btn mat-btn--ghost mat-btn--icon mat-btn--sm" id="replace-next" aria-label="Nächster Treffer (F3)" data-tip="Nächster Treffer (F3)">@Ui.Icon("arrow-down")</button>
                <button type="button" class="mat-btn mat-btn--secondary mat-btn--sm" id="replace-one">Ersetzen</button>
                <button type="button" class="mat-btn mat-btn--secondary mat-btn--sm" id="replace-all">Alle ersetzen</button>
            </div>
            <div class="kk-find__options">
                <label class="mat-check"><input type="checkbox" id="replace-case" /><span class="mat-check__text">Groß/klein</span></label>
                <label class="mat-check"><input type="checkbox" id="replace-whole" /><span class="mat-check__text">Ganze Wörter</span></label>
                <span class="mat-hint" id="replace-info" aria-live="polite"></span>
            </div>
            <button type="button" class="mat-btn mat-btn--ghost mat-btn--icon mat-btn--sm kk-find__close" id="replace-close" aria-label="Suche schließen (Esc)" data-tip="Schließen (Esc)">@Ui.Icon("x")</button>
        </div>
    </div>

    @* What the export makes is the saved text: a click saves first (editor.js), then the file comes. *@
    <div class="mat-menu" id="editor-export-menu" role="menu" aria-label="Exportieren" hidden>
        <a class="mat-menu__item" role="menuitem" data-export href="/Documents/Export?id=@d.Id&format=@nameof(ExportFormat.DocxTracked)">@Ui.Icon("download")<span>Word mit Änderungen</span></a>
        <a class="mat-menu__item" role="menuitem" data-export href="/Documents/Export?id=@d.Id&format=@nameof(ExportFormat.DocxClean)">@Ui.Icon("download")<span>Word bereinigt</span></a>
        <a class="mat-menu__item" role="menuitem" data-export href="/Documents/Export?id=@d.Id&format=@nameof(ExportFormat.PdfChanges)">@Ui.Icon("download")<span>PDF mit Änderungen</span></a>
        <a class="mat-menu__item" role="menuitem" data-export href="/Documents/Export?id=@d.Id&format=@nameof(ExportFormat.PdfClean)">@Ui.Icon("download")<span>PDF bereinigt</span></a>
        <a class="mat-menu__item" role="menuitem" data-export href="/Documents/Export?id=@d.Id&format=@nameof(ExportFormat.Text)">@Ui.Icon("download")<span>Nur Text</span></a>
        <div class="mat-menu__sep" role="separator"></div>
        <a class="mat-menu__item" role="menuitem" href="/Documents/Details?id=@d.Id&tab=export">@Ui.Icon("sliders")<span>Weitere Optionen …</span></a>
    </div>

    <div class="mat-menu" id="editor-more-menu" role="menu" aria-label="Mehr" hidden>
        <a class="mat-menu__item" role="menuitem" href="/Documents/Compare?id=@d.Id&from=@(Math.Max(1, d.CurrentVersionNo - 1))&to=@d.CurrentVersionNo">@Ui.Icon("columns")<span>Änderungen ansehen</span></a>
        <a class="mat-menu__item" role="menuitem" href="/Documents/Details?id=@d.Id">@Ui.Icon("history")<span>Fassungen und Dokumentseite</span></a>
        @if (d.Kind == DocumentKind.Pdf && d.OriginalFileId is not null)
        {
            <button type="button" class="mat-menu__item" role="menuitem" id="editor-original" aria-pressed="false">@Ui.Icon("eye")<span>Das Original-PDF daneben zeigen</span></button>
        }
        <button type="button" class="mat-menu__item" role="menuitemcheckbox" id="editor-reference-toggle" aria-pressed="false">@Ui.Icon("columns")<span>Frühere Fassung daneben (Alt+R)</span></button>
        <button type="button" class="mat-menu__item kk-editor__phone" role="menuitem" id="editor-close-menu">@Ui.Icon("check-circle")<span>Durchgang abschließen</span></button>
        <div class="mat-menu__sep" role="separator"></div>
        <button type="button" class="mat-menu__item" role="menuitem" id="editor-keys-open">@Ui.Icon("help-circle")<span>Tastenkürzel (Alt+H)</span></button>
    </div>

    <div class="kk-editor__body">
        <aside class="kk-editor__reference" id="editor-reference" aria-label="Frühere Fassung mit den Änderungen" hidden>
            <div class="kk-editor__reference-head">
                <label class="mat-sr-only" for="reference-from">Vergleichen mit</label>
                <select class="mat-select mat-select--sm" id="reference-from"></select>
                <button type="button" class="mat-btn mat-btn--ghost mat-btn--icon mat-btn--sm" id="reference-close" aria-label="Schließen" data-tip="Schließen">@Ui.Icon("x")</button>
            </div>
            <p class="mat-hint kk-editor__reference-note" id="reference-note" aria-live="polite"></p>
            <div class="kk-editor__reference-body"></div>
        </aside>
        @if (d.Kind == DocumentKind.Pdf && d.OriginalFileId is not null)
        {
            <aside class="kk-editor__original" id="editor-original-pane" aria-label="Original-PDF" hidden>
                <iframe title="Das hochgeladene PDF" data-src="/Documents/Download?id=@d.Id&inline=true#view=FitH"></iframe>
            </aside>
        }
        <div class="kk-editor__paper" id="paras" aria-label="Text des Dokuments"></div>
        <aside class="kk-editor__side" id="editor-side" aria-label="Kommentare und Stilblatt" hidden>
            <section>
                <h2>Kommentare</h2>
                <ul class="kk-comments" id="comment-list"></ul>
            </section>
            <section>
                <h2>Stilblatt</h2>
                <ul class="kk-comments" id="style-list"></ul>
                <button type="button" class="mat-btn mat-btn--ghost mat-btn--sm" id="style-add" data-tip="Das markierte Wort ins Stilblatt (Alt+S)">@Ui.Icon("plus")<span>Eintrag</span></button>
                <a class="mat-btn mat-btn--ghost mat-btn--sm" href="/Projects/Style?projectId=@d.ProjectId" data-tip="Das ganze Stilblatt bearbeiten">@Ui.Icon("book")<span>Stilblatt</span></a>
            </section>
        </aside>
    </div>

    <dialog class="mat-dialog mat-dialog--sm" id="editor-comment" aria-labelledby="comment-title">
        <div class="mat-dialog__form">
            <div class="mat-dialog__head">@Ui.Icon("message-square")<h2 class="mat-dialog__title" id="comment-title">Kommentar</h2><button type="button" class="mat-btn mat-btn--ghost mat-btn--icon mat-dialog__close" data-dialog-close aria-label="Schließen">@Ui.Icon("x")</button></div>
            <div class="mat-dialog__body mat-form">
                <p class="mat-muted" id="comment-for"></p>
                <div class="mat-field"><label class="mat-label" for="comment-text">Dein Kommentar</label><textarea class="mat-textarea" id="comment-text" rows="4"></textarea></div>
            </div>
            <div class="mat-dialog__foot">
                <div class="mat-btn-row mat-btn-row--plain">
                    <button type="button" class="mat-btn mat-btn--primary" id="comment-save">@Ui.Icon("check")<span>Speichern</span></button>
                    <button type="button" class="mat-btn mat-btn--secondary" data-dialog-close>Abbrechen</button>
                </div>
            </div>
        </div>
    </dialog>

    <dialog class="mat-dialog mat-dialog--sm" id="editor-style" aria-labelledby="style-title">
        <div class="mat-dialog__form">
            <div class="mat-dialog__head">@Ui.Icon("book")<h2 class="mat-dialog__title" id="style-title">Ins Stilblatt</h2><button type="button" class="mat-btn mat-btn--ghost mat-btn--icon mat-dialog__close" data-dialog-close aria-label="Schließen">@Ui.Icon("x")</button></div>
            <div class="mat-dialog__body mat-form">
                <div class="mat-field"><label class="mat-label" for="style-category">Art</label>
                    <select class="mat-select" id="style-category">
                        @foreach (var c in Enum.GetValues<StyleCategory>())
                        {
                            <option value="@c" selected="@(c == StyleCategory.Spelling)">@Labels.Of(c)</option>
                        }
                    </select></div>
                <div class="mat-field"><label class="mat-label" for="style-term">Eintrag</label><input class="mat-input" id="style-term" maxlength="200" autocomplete="off" /></div>
                <div class="mat-field"><label class="mat-label" for="style-decision">Entscheidung</label><input class="mat-input" id="style-decision" autocomplete="off" /><span class="mat-hint">Zum Beispiel die Schreibweise, die im ganzen Manuskript gilt.</span></div>
                <p class="mat-error" id="style-error" aria-live="polite"></p>
            </div>
            <div class="mat-dialog__foot">
                <div class="mat-btn-row mat-btn-row--plain">
                    <button type="button" class="mat-btn mat-btn--primary" id="style-save">@Ui.Icon("check")<span>Speichern</span></button>
                    <button type="button" class="mat-btn mat-btn--secondary" data-dialog-close>Abbrechen</button>
                </div>
            </div>
        </div>
    </dialog>

    <dialog class="mat-dialog mat-dialog--sm" id="editor-keys" aria-labelledby="keys-title">
        <div class="mat-dialog__form">
            <div class="mat-dialog__head">@Ui.Icon("help-circle")<h2 class="mat-dialog__title" id="keys-title">Tastenkürzel</h2><button type="button" class="mat-btn mat-btn--ghost mat-btn--icon mat-dialog__close" data-dialog-close aria-label="Schließen">@Ui.Icon("x")</button></div>
            <div class="mat-dialog__body">
                <dl class="kk-keys">
                    <dt><kbd>Strg</kbd> + <kbd>S</kbd></dt><dd>Speichern (die Fassung bleibt in Arbeit)</dd>
                    <dt><kbd>Alt</kbd> + <kbd>A</kbd></dt><dd>Durchgang abschließen</dd>
                    <dt><kbd>Alt</kbd> + <kbd>K</kbd></dt><dd>Kommentar zur Markierung oder zum Absatz</dd>
                    <dt><kbd>Alt</kbd> + <kbd>↓</kbd> / <kbd>↑</kbd></dt><dd>Nächster / voriger offener Kommentar</dd>
                    <dt><kbd>Alt</kbd> + <kbd>L</kbd></dt><dd>Kommentare und Stilblatt ein- oder ausblenden</dd>
                    <dt><kbd>Alt</kbd> + <kbd>W</kbd></dt><dd>Zwischen Text und Seite wechseln</dd>
                    <dt><kbd>Alt</kbd> + <kbd>X</kbd></dt><dd>Exportieren (Word, PDF, Text)</dd>
                    <dt><kbd>Alt</kbd> + <kbd>S</kbd></dt><dd>Das markierte Wort ins Stilblatt des Projekts eintragen</dd>
                    <dt><kbd>Alt</kbd> + <kbd>R</kbd></dt><dd>Die frühere Fassung mit den Änderungen daneben zeigen (Änderungsmodus)</dd>
                    <dt><kbd>Alt</kbd> + <kbd>V</kbd></dt><dd>Vollbild: Menü und Kopfzeile aus- und einblenden (<kbd>Esc</kbd> beendet es)</dd>
                    <dt><kbd>Strg</kbd> + <kbd>H</kbd></dt><dd>Suchen und ersetzen</dd>
                    <dt><kbd>F3</kbd> / <kbd>Umschalt</kbd> + <kbd>F3</kbd></dt><dd>Nächster / voriger Treffer</dd>
                    <dt><kbd>Strg</kbd> + <kbd>Z</kbd> / <kbd>Y</kbd></dt><dd>Rückgängig / wiederholen</dd>
                    <dt><kbd>Alt</kbd> + <kbd>H</kbd></dt><dd>Diese Übersicht</dd>
                </dl>
                <p class="mat-hint">In der Textansicht trennt <kbd>Enter</kbd> einen Absatz, <kbd>Rück</kbd> am Anfang verbindet ihn mit dem davor.</p>
            </div>
            <div class="mat-dialog__foot">
                <div class="mat-btn-row mat-btn-row--plain">
                    <button type="button" class="mat-btn mat-btn--secondary" data-dialog-close>Schließen</button>
                </div>
            </div>
        </div>
    </dialog>
</div>

@section Scripts {
    <script src="~/js/editor.js" asp-append-version="true"></script>
    <script src="~/js/editor-page.js" asp-append-version="true"></script>
}
