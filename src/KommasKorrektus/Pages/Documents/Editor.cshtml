@page
@model KommasKorrektus.Pages.Documents.EditorModel
@{
    var d = Model.Document;
}

<div class="kk-editor" id="kk-editor">
    @Html.AntiForgeryToken()
    <script type="application/json" id="editor-data">@Html.Raw(Model.DataJson)</script>

    <div class="kk-editor__bar mat-card">
        <div class="kk-editor__title">
            <h1>@d.Title</h1>
            <p class="mat-muted"><a href="/Projects/Details?id=@d.ProjectId&tab=documents">@d.Project!.Title</a> · <span id="editor-version">Fassung @Model.Version.VersionNo@(Model.Version.Origin switch { VersionOrigin.Working => " · in Arbeit", VersionOrigin.Manual => " · abgeschlossen", _ => "" })</span> · <span id="editor-words">0</span> Wörter</p>
        </div>
        <div class="kk-editor__state">
            <span id="editor-status" class="kk-editor__status is-saved" aria-live="polite" role="status">Geöffnet</span>
            <small class="mat-muted" id="editor-session"></small>
        </div>
        <div class="kk-editor__actions">
            <div class="mat-seg" role="group" aria-label="Ansicht">
                <button type="button" class="mat-seg__btn" data-view="text" aria-pressed="true" data-tip="Nur der Text, ohne Ablenkung durch das Layout (Alt+W wechselt)">@Ui.Icon("type")<span>Text</span></button>
                <button type="button" class="mat-seg__btn" data-view="page" aria-pressed="false" disabled data-tip="Die Seite mit der Formatierung des Originals (Alt+W wechselt)">@Ui.Icon("file")<span>Seite</span></button>
            </div>
            <button type="button" class="mat-btn mat-btn--primary" id="editor-save" data-tip="Speichern: die Fassung bleibt in Arbeit (Strg+S)">@Ui.Icon("save")<span>Speichern</span></button>
            <button type="button" class="mat-btn mat-btn--secondary" id="editor-close" data-tip="Den Durchgang beenden: die nächste Änderung beginnt eine neue Fassung (Alt+A)">@Ui.Icon("check-circle")<span>Durchgang abschließen</span></button>
            <button type="button" class="mat-btn mat-btn--ghost mat-btn--icon" id="editor-undo" aria-label="Rückgängig (Strg+Z)" data-tip="Rückgängig" disabled>@Ui.Icon("undo")</button>
            <button type="button" class="mat-btn mat-btn--ghost mat-btn--icon" id="editor-redo" aria-label="Wiederholen (Strg+Y)" data-tip="Wiederholen" disabled>@Ui.Icon("redo")</button>
            <button type="button" class="mat-btn mat-btn--ghost mat-btn--icon" id="editor-find" aria-label="Suchen und ersetzen (Strg+H)" data-tip="Suchen und ersetzen">@Ui.Icon("search")</button>
            @if (d.Kind == DocumentKind.Pdf && d.OriginalFileId is not null)
            {
                <button type="button" class="mat-btn mat-btn--ghost mat-btn--icon" id="editor-original" aria-pressed="false" aria-label="Das Original-PDF daneben zeigen" data-tip="Das Original-PDF daneben zeigen">@Ui.Icon("eye")</button>
            }
            <button type="button" class="mat-btn mat-btn--ghost mat-btn--icon" id="editor-side-toggle" aria-pressed="false" aria-label="Kommentare und Stilblatt (Alt+L)" data-tip="Kommentare und Stilblatt (Alt+L)">@Ui.Icon("message-square")<span class="mat-badge mat-badge--soft" id="comment-count">0</span></button>
            <a class="mat-btn mat-btn--ghost mat-btn--icon" href="/Documents/Compare?id=@d.Id&from=@(Math.Max(1, d.CurrentVersionNo - 1))&to=@d.CurrentVersionNo" aria-label="Änderungen ansehen" data-tip="Änderungen ansehen">@Ui.Icon("columns")</a>
            <button type="button" class="mat-btn mat-btn--ghost mat-btn--icon" id="editor-export" data-menu-toggle="editor-export-menu" aria-haspopup="menu" aria-expanded="false" aria-label="Exportieren (Alt+X)" data-tip="Exportieren: Word oder PDF (Alt+X)">@Ui.Icon("download")</button>
            <a class="mat-btn mat-btn--ghost mat-btn--icon" href="/Documents/Details?id=@d.Id" aria-label="Zur Dokumentseite" data-tip="Fassungen und weitere Exporte">@Ui.Icon("history")</a>
            <button type="button" class="mat-btn mat-btn--ghost mat-btn--icon" id="editor-keys-open" aria-label="Tastenkürzel (Alt+H)" data-tip="Tastenkürzel (Alt+H)">@Ui.Icon("help-circle")</button>
        </div>
    </div>

    @* What the export makes is the saved text: a click saves first (editor.js), then the file comes. *@
    <div class="mat-menu" id="editor-export-menu" role="menu" aria-label="Exportieren" hidden>
        <a class="mat-menu__item" role="menuitem" data-export href="/Documents/Export?id=@d.Id&format=@nameof(ExportFormat.DocxTracked)">@Ui.Icon("download")<span>Word mit Änderungen</span></a>
        <a class="mat-menu__item" role="menuitem" data-export href="/Documents/Export?id=@d.Id&format=@nameof(ExportFormat.DocxClean)">@Ui.Icon("download")<span>Word bereinigt</span></a>
        <a class="mat-menu__item" role="menuitem" data-export href="/Documents/Export?id=@d.Id&format=@nameof(ExportFormat.PdfChanges)">@Ui.Icon("download")<span>PDF mit Änderungen</span></a>
        <a class="mat-menu__item" role="menuitem" data-export href="/Documents/Export?id=@d.Id&format=@nameof(ExportFormat.PdfClean)">@Ui.Icon("download")<span>PDF bereinigt</span></a>
        <a class="mat-menu__item" role="menuitem" data-export href="/Documents/Export?id=@d.Id&format=@nameof(ExportFormat.Text)">@Ui.Icon("download")<span>Nur Text</span></a>
        <div class="mat-menu__sep" role="separator"></div>
        <a class="mat-menu__item" role="menuitem" href="/Documents/Details?id=@d.Id&tab=export">@Ui.Icon("sliders")<span>Weitere Optionen …</span></a>
    </div>

    <div class="kk-editor__body">
        @if (d.Kind == DocumentKind.Pdf && d.OriginalFileId is not null)
        {
            <aside class="kk-editor__original" id="editor-original-pane" aria-label="Original-PDF" hidden>
                <iframe title="Das hochgeladene PDF" data-src="/Documents/Download?id=@d.Id&inline=true#view=FitH"></iframe>
            </aside>
        }
        <div class="kk-editor__paper" id="paras" aria-label="Text des Dokuments"></div>
        <aside class="kk-editor__side" id="editor-side" aria-label="Kommentare und Stilblatt" hidden>
            <section>
                <h2>Kommentare</h2>
                <ul class="kk-comments" id="comment-list"></ul>
            </section>
            <section>
                <h2>Stilblatt</h2>
                <ul class="kk-comments" id="style-list"></ul>
                <a class="mat-btn mat-btn--ghost mat-btn--sm" href="/Projects/Style?projectId=@d.ProjectId">@Ui.Icon("plus")<span>Eintrag</span></a>
            </section>
        </aside>
    </div>

    <dialog class="mat-dialog mat-dialog--sm" id="editor-replace" aria-labelledby="replace-title">
        <div class="mat-dialog__form">
            <div class="mat-dialog__head">@Ui.Icon("search")<h2 class="mat-dialog__title" id="replace-title">Suchen und ersetzen</h2><button type="button" class="mat-btn mat-btn--ghost mat-btn--icon mat-dialog__close" data-dialog-close aria-label="Schließen">@Ui.Icon("x")</button></div>
            <div class="mat-dialog__body mat-form">
                <div class="mat-field"><label class="mat-label" for="replace-find">Suchen</label><input class="mat-input" id="replace-find" autocomplete="off" /></div>
                <div class="mat-field"><label class="mat-label" for="replace-with">Ersetzen durch</label><input class="mat-input" id="replace-with" autocomplete="off" /></div>
                <label class="mat-switch"><input type="checkbox" id="replace-case" /><span class="mat-switch__track"></span><span>Groß- und Kleinschreibung beachten</span></label>
                <label class="mat-switch"><input type="checkbox" id="replace-whole" /><span class="mat-switch__track"></span><span>Nur ganze Wörter</span></label>
                <p class="mat-hint" id="replace-info" aria-live="polite"></p>
            </div>
            <div class="mat-dialog__foot">
                <div class="mat-btn-row mat-btn-row--plain">
                    <button type="button" class="mat-btn mat-btn--primary" id="replace-next">@Ui.Icon("search")<span>Weitersuchen</span></button>
                    <button type="button" class="mat-btn mat-btn--secondary" id="replace-one">Ersetzen</button>
                    <button type="button" class="mat-btn mat-btn--secondary" id="replace-all">Alle ersetzen</button>
                    <span class="mat-btn-row__spacer"></span>
                    <button type="button" class="mat-btn mat-btn--ghost mat-btn--end" data-dialog-close>Schließen</button>
                </div>
            </div>
        </div>
    </dialog>

    <dialog class="mat-dialog mat-dialog--sm" id="editor-comment" aria-labelledby="comment-title">
        <div class="mat-dialog__form">
            <div class="mat-dialog__head">@Ui.Icon("message-square")<h2 class="mat-dialog__title" id="comment-title">Kommentar</h2><button type="button" class="mat-btn mat-btn--ghost mat-btn--icon mat-dialog__close" data-dialog-close aria-label="Schließen">@Ui.Icon("x")</button></div>
            <div class="mat-dialog__body mat-form">
                <p class="mat-muted" id="comment-for"></p>
                <div class="mat-field"><label class="mat-label" for="comment-text">Dein Kommentar</label><textarea class="mat-textarea" id="comment-text" rows="4"></textarea></div>
            </div>
            <div class="mat-dialog__foot">
                <div class="mat-btn-row mat-btn-row--plain">
                    <button type="button" class="mat-btn mat-btn--primary" id="comment-save">@Ui.Icon("check")<span>Speichern</span></button>
                    <button type="button" class="mat-btn mat-btn--secondary" data-dialog-close>Abbrechen</button>
                </div>
            </div>
        </div>
    </dialog>

    <dialog class="mat-dialog mat-dialog--sm" id="editor-keys" aria-labelledby="keys-title">
        <div class="mat-dialog__form">
            <div class="mat-dialog__head">@Ui.Icon("help-circle")<h2 class="mat-dialog__title" id="keys-title">Tastenkürzel</h2><button type="button" class="mat-btn mat-btn--ghost mat-btn--icon mat-dialog__close" data-dialog-close aria-label="Schließen">@Ui.Icon("x")</button></div>
            <div class="mat-dialog__body">
                <dl class="kk-keys">
                    <dt><kbd>Strg</kbd> + <kbd>S</kbd></dt><dd>Speichern (die Fassung bleibt in Arbeit)</dd>
                    <dt><kbd>Alt</kbd> + <kbd>A</kbd></dt><dd>Durchgang abschließen</dd>
                    <dt><kbd>Alt</kbd> + <kbd>K</kbd></dt><dd>Kommentar zur Markierung oder zum Absatz</dd>
                    <dt><kbd>Alt</kbd> + <kbd>↓</kbd> / <kbd>↑</kbd></dt><dd>Nächster / voriger offener Kommentar</dd>
                    <dt><kbd>Alt</kbd> + <kbd>L</kbd></dt><dd>Kommentare und Stilblatt ein- oder ausblenden</dd>
                    <dt><kbd>Alt</kbd> + <kbd>W</kbd></dt><dd>Zwischen Text und Seite wechseln</dd>
                    <dt><kbd>Alt</kbd> + <kbd>X</kbd></dt><dd>Exportieren (Word, PDF, Text)</dd>
                    <dt><kbd>Strg</kbd> + <kbd>H</kbd></dt><dd>Suchen und ersetzen</dd>
                    <dt><kbd>F3</kbd> / <kbd>Umschalt</kbd> + <kbd>F3</kbd></dt><dd>Nächster / voriger Treffer</dd>
                    <dt><kbd>Strg</kbd> + <kbd>Z</kbd> / <kbd>Y</kbd></dt><dd>Rückgängig / wiederholen</dd>
                    <dt><kbd>Alt</kbd> + <kbd>H</kbd></dt><dd>Diese Übersicht</dd>
                </dl>
                <p class="mat-hint">In der Textansicht trennt <kbd>Enter</kbd> einen Absatz, <kbd>Rück</kbd> am Anfang verbindet ihn mit dem davor.</p>
            </div>
            <div class="mat-dialog__foot">
                <div class="mat-btn-row mat-btn-row--plain">
                    <button type="button" class="mat-btn mat-btn--secondary" data-dialog-close>Schließen</button>
                </div>
            </div>
        </div>
    </dialog>
</div>

@section Scripts {
    <script src="~/js/editor.js" asp-append-version="true"></script>
    <script src="~/js/editor-page.js" asp-append-version="true"></script>
}
