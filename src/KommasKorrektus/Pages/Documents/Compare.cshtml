@page
@model KommasKorrektus.Pages.Documents.CompareModel
@{
    var d = Model.Document;
}

@Html.AntiForgeryToken()
<form class="mat-form kk-diff__bar" method="get" action="/Documents/Compare" id="compare-form">
    <input type="hidden" name="id" value="@d.Id" />
    <div class="mat-field"><label class="mat-label" for="from">Alt</label><select class="mat-select" id="from" name="from">@foreach (var o in Model.VersionOptions) { <option value="@o.Value" selected="@(o.Value == Model.From.ToString())">@o.Text</option> }</select></div>
    <div class="mat-field"><label class="mat-label" for="to">Neu</label><select class="mat-select" id="to" name="to">@foreach (var o in Model.VersionOptions) { <option value="@o.Value" selected="@(o.Value == Model.To.ToString())">@o.Text</option> }</select></div>
    <div class="mat-field">
        <span class="mat-label">Ansicht</span>
        <div class="mat-seg" role="group" aria-label="Ansicht">
            <button type="submit" name="mode" value="pages" class="mat-seg__btn" aria-pressed="@(Model.PagesView ? "true" : "false")" data-tip="Die alte und die neue Seite nebeneinander, in der Formatierung des Originals">@Ui.Icon("copy")<span>Zwei Seiten</span></button>
            <button type="submit" name="mode" value="page" class="mat-seg__btn" aria-pressed="@(Model.PageView ? "true" : "false")" data-tip="Die Änderungen in der Formatierung des Originals">@Ui.Icon("file")<span>Seite</span></button>
            <button type="submit" name="mode" value="side" class="mat-seg__btn" aria-pressed="@(Model.Mode == "side" ? "true" : "false")" data-tip="Nur der Text, alt und neu nebeneinander">@Ui.Icon("columns")<span>Text nebeneinander</span></button>
            <button type="submit" name="mode" value="inline" class="mat-seg__btn" aria-pressed="@(Model.Inline ? "true" : "false")" data-tip="Nur der Text, die Änderungen darin">@Ui.Icon("file-text")<span>Ein Text</span></button>
        </div>
    </div>
    <div class="mat-field">
        <label class="mat-switch"><input type="checkbox" id="changes" name="changes" value="true" checked="@Model.Changes" data-submit-on-change /><span class="mat-switch__track"></span><span>Nur Änderungen</span></label>
        <input type="hidden" name="changes" value="false" />
    </div>
    <button type="submit" class="mat-btn mat-btn--secondary">@Ui.Icon("refresh")<span>Anzeigen</span></button>
</form>

<div class="mat-card kk-diff__stats">
    <div class="mat-card__body mat-row mat-row--between">
        <div class="mat-row">
            <span><span class="kk-ins">+@Fmt.Integer(Model.Stats.WordsAdded)</span> Wörter neu</span>
            <span><span class="kk-del">−@Fmt.Integer(Model.Stats.WordsRemoved)</span> entfernt</span>
            <span><strong>@Fmt.Integer(Model.Stats.WordsChanged)</strong> ersetzt</span>
            <span class="mat-muted">in @Fmt.Integer(Model.Stats.ParagraphsChanged) Absätzen</span>
        </div>
        <div class="mat-row">
            @if (Model.PagesView)
            {
                <div class="kk-zoom" role="group" aria-label="Schriftgröße" data-zoom="@Model.Zoom">
                    <button type="button" class="mat-btn mat-btn--ghost mat-btn--icon mat-btn--sm" data-zoom-step="-1" aria-label="Schrift kleiner" data-tip="Schrift kleiner">@Ui.Icon("minus")</button>
                    <button type="button" class="mat-btn mat-btn--ghost mat-btn--sm kk-zoom__value" data-zoom-reset aria-label="Schriftgröße auf 100 % zurücksetzen" data-tip="Auf 100 % zurück">@Model.Zoom %</button>
                    <button type="button" class="mat-btn mat-btn--ghost mat-btn--icon mat-btn--sm" data-zoom-step="1" aria-label="Schrift größer" data-tip="Schrift größer">@Ui.Icon("plus")</button>
                </div>
            }
            <button type="button" class="mat-btn mat-btn--ghost mat-btn--sm" data-diff-step="-1">@Ui.Icon("arrow-up")<span>Vorige Änderung</span></button>
            <button type="button" class="mat-btn mat-btn--ghost mat-btn--sm" data-diff-step="1">@Ui.Icon("arrow-down")<span>Nächste Änderung</span></button>
        </div>
    </div>
</div>

@if (!Model.Stats.HasChanges)
{
    <div class="mat-empty"><span class="mat-empty__icon">@Ui.Icon("check-circle")</span><div class="mat-empty__title">Keine Unterschiede</div><p>Die beiden Fassungen haben denselben Text.</p></div>
}
else if (Model.PagesView && Model.FromSheet is { } fromSheet && Model.ToSheet is { } toSheet)
{
    <div class="kk-pages" id="pages" data-changes="@(Model.Changes ? "true" : "false")">
        <div class="kk-pages__side"><h2 class="kk-pages__title">Fassung @Model.From <small class="mat-muted">früher: rot ist, was wegfällt</small></h2>@LayoutView.Plain(fromSheet, "old", Model.Zoom)</div>
        <div class="kk-pages__side"><h2 class="kk-pages__title">Fassung @Model.To <small class="mat-muted">neu: grün ist, was dazukam</small></h2>@LayoutView.Plain(toSheet, "new", Model.Zoom)</div>
    </div>

    if (!fromSheet.Formatted || !toSheet.Formatted)
    {
        <p class="mat-hint">Das Original ist keine Word-Datei (oder sein Text ist nicht mehr der des Imports): Die Seite zeigt den Text einfach, ohne Formatierung.</p>
    }
}
else if (Model.PageView && Model.Sheet is { } sheet)
{
    var last = Model.Pager.Page >= (int)Math.Ceiling(Model.Pager.Total / (double)Model.Pager.PageSize);
    @LayoutView.Render(sheet, Model.PageItems, withNotes: last, diff: true)

    if (!sheet.Formatted)
    {
        <p class="mat-hint">Das Original ist keine Word-Datei (oder sein Text ist nicht mehr der des Imports): Die Seite zeigt den Text einfach, ohne Formatierung.</p>
    }
}
else
{
    @DiffView.Render(Model.Items, Model.Inline, $"Fassung {Model.From}", $"Fassung {Model.To}")
}

<partial name="_Pager" model="Model.Pager" />

<div class="mat-actions">
    <a class="mat-btn mat-btn--primary" href="/Documents/Export?id=@d.Id&from=@Model.From&to=@Model.To&format=@nameof(ExportFormat.DocxTracked)">@Ui.Icon("download")<span>Word mit Änderungen</span></a>
    <a class="mat-btn mat-btn--secondary" href="/Documents/Export?id=@d.Id&from=@Model.From&to=@Model.To&format=@nameof(ExportFormat.PdfChanges)">@Ui.Icon("download")<span>PDF</span></a>
    <a class="mat-btn mat-btn--secondary" href="/Documents/Details?id=@d.Id&tab=versions">@Ui.Icon("back")<span>Zurück</span></a>
</div>

@section Scripts {
    <script src="~/js/sheet.js" asp-append-version="true"></script>
    @if (Model.PagesView)
    {
        <script src="~/js/zoom.js" asp-append-version="true"></script>
        <script src="~/js/textdiff.js" asp-append-version="true"></script>
        <script src="~/js/pagetext.js" asp-append-version="true"></script>
        <script src="~/js/sidebyside.js" asp-append-version="true"></script>
        <script src="~/js/compare-pages.js" asp-append-version="true"></script>
    }
    else
    {
        <script src="~/js/diff.js" asp-append-version="true"></script>
    }
}
