@page
@model KommasKorrektus.Pages.Documents.NewVersionModel
@{
    var back = $"/Documents/Details?id={Model.Id}";
}

<form class="mat-form" method="post" enctype="multipart/form-data" novalidate>
    <input type="hidden" name="Id" value="@Model.Id" />
    <kk-summary />
    <kk-card title="@Model.Document.Title" icon="upload">
        <p class="mat-muted">Die Datei, die der Kunde zurückgeschickt hat, wird <strong>Fassung @Model.NextNo</strong> dieses Dokuments: Word (.docx), PDF oder Text (.txt). Was der Kunde geändert hat, siehst du gleich im Vergleich mit Fassung @Model.Document.CurrentVersionNo; mit jeder anderen Fassung lässt sie sich ebenso vergleichen. Bei einem Word-Dokument gilt seine Formatierung für alles, was du ab jetzt änderst.</p>
        <div class="mat-form__grid">
            <div class="mat-field mat-field--full @(ViewData.ModelState.ContainsKey("UploadedFile") ? "is-invalid" : "")">
                <label class="mat-label" for="UploadedFile">Datei <span class="mat-req" aria-hidden="true">*</span></label>
                <input class="mat-input" type="file" id="UploadedFile" name="UploadedFile" accept=".docx,.pdf,.txt,.md,application/vnd.openxmlformats-officedocument.wordprocessingml.document,application/pdf,text/plain" required data-msg-required="Bitte wähle eine Datei aus." />
                <span class="mat-hint">Bis @(DocumentService.MaxUploadBytes / 1024 / 1024) MB.</span>
                <span class="mat-error" aria-live="polite">@(ViewData.ModelState.TryGetValue("UploadedFile", out var e) && e.Errors.Count > 0 ? e.Errors[0].ErrorMessage : "")</span>
            </div>
            <kk-input for="Label" label="Name der Fassung" full="true" hint="Leer: „Datei vom Kunden“. Zum Beispiel „Datei vom Kunden v2“." />
            <kk-textarea for="Comment" label="Anmerkung" rows="3" full="true" />
        </div>
    </kk-card>
    <kk-buttons save-text="Als nächste Fassung übernehmen" save-icon="upload" back-href="@back" />
</form>
