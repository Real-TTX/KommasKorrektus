@page
@model KommaKorrektus.Pages.Projects.StyleModel
@{
    var categories = Controls.Options.Of<StyleCategory>(Labels.Of);
    var back = $"/Projects/Details?id={Model.ProjectId}&tab=style";
}

<form class="mat-form" method="post" novalidate>
    <input type="hidden" name="ProjectId" value="@Model.ProjectId" />
    <input type="hidden" name="Id" value="@Model.Id" />
    <kk-summary />
    <kk-card title="@Model.Project.Title" icon="book">
        <div class="mat-form__grid">
            <kk-select for="Input.Category" label="Art" items="categories" />
            <kk-input for="Input.Term" label="Eintrag" required="true" hint="Der Name, das Wort oder die Regel." />
            <kk-input for="Input.Decision" label="Entscheidung" full="true" hint="Zum Beispiel: immer „Aurelia“, nie „Aurellia“." />
            <kk-textarea for="Input.Note" label="Anmerkung" rows="3" full="true" />
        </div>
    </kk-card>
    @if (Model.Id is not null)
    {
        <kk-buttons back-href="@back" delete-url="@Url.Page("/Projects/Style", "Delete", new { projectId = Model.ProjectId, id = Model.Id })" delete-confirm="Diesen Eintrag löschen?" />
    }
    else
    {
        <kk-buttons back-href="@back" />
    }
</form>
