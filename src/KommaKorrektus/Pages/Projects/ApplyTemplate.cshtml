@page
@model KommaKorrektus.Pages.Projects.ApplyTemplateModel
@{
    var back = $"/Projects/Details?id={Model.ProjectId}&tab=tasks";
}

<form class="mat-form" method="post" novalidate>
    <input type="hidden" name="ProjectId" value="@Model.ProjectId" />
    <kk-card title="@Model.Project.Title" icon="template">
        <p class="mat-muted">Die Aufgaben der Vorlage werden zu den vorhandenen hinzugefügt. Die Fristen zählen ab dem Beginn des Projekts@(Model.Project.StartDate is null ? " (hat keinen: ab heute)" : "").</p>
        <div class="mat-form__grid">
            <kk-select name="TemplateId" label="Vorlage" items="Model.Templates" required="true" full="true" />
        </div>
    </kk-card>
    <kk-buttons save-text="Aufgaben anlegen" save-icon="template" back-href="@back" />
</form>
