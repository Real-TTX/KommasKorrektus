@page "/s/{token:guid}/document/{id:long}"
@model KommaKorrektus.Pages.Share.DocumentModel
@{
    Layout = "_Bare";
    var link = Model.Link;
}

<partial name="_Header" model="Model" />

@if (Model.CanShow)
{
    var doc = Model.Document;
    var mode = Model.ViewMode;
    var token = Model.Token;

    <div class="kk-share__intro">
        <h1>@doc.Title</h1>
        <p class="mat-muted">
            @link.Title · Fassung @Model.Version.VersionNo vom @Fmt.Date(Model.Version.CreateDate) · @Fmt.Integer(Model.Version.WordCount) Wörter · gültig bis @Fmt.Date(link.ExpiresDate)
        </p>
        @if (!string.IsNullOrWhiteSpace(link.Message))
        {
            <p class="kk-share__message">@link.Message</p>
        }
        @if (link.ApprovedDate is not null)
        {
            <p class="mat-badge mat-badge--success">@Ui.Icon("check-circle")<span>Freigegeben von @link.ApprovedByName am @Fmt.Date(link.ApprovedDate)</span></p>
        }
    </div>

    <div class="mat-row mat-row--between kk-share__bar">
        @if (link.DocumentId is null)
        {
            <a class="mat-btn mat-btn--ghost" href="/s/@token">@Ui.Icon("back")<span>Alle Dokumente</span></a>
        }
        @if (Model.HasChanges)
        {
            <div class="mat-seg" role="group" aria-label="Ansicht">
                <a class="mat-seg__btn" href="/s/@token/document/@doc.Id?mode=changes" aria-pressed="@(mode == "changes" ? "true" : "false")">@Ui.Icon("file-text")<span>Mit Änderungen</span></a>
                <a class="mat-seg__btn" href="/s/@token/document/@doc.Id?mode=side" aria-pressed="@(mode == "side" ? "true" : "false")">@Ui.Icon("columns")<span>Alt und neu</span></a>
                <a class="mat-seg__btn" href="/s/@token/document/@doc.Id?mode=text" aria-pressed="@(mode == "text" ? "true" : "false")">@Ui.Icon("eye")<span>Nur der Text</span></a>
            </div>
        }
    </div>

    @if (mode != "text")
    {
        <div class="mat-card kk-diff__stats">
            <div class="mat-card__body mat-row mat-row--between">
                <div class="mat-row">
                    <span><span class="kk-ins">+@Fmt.Integer(Model.Stats.WordsAdded)</span> Wörter neu</span>
                    <span><span class="kk-del">−@Fmt.Integer(Model.Stats.WordsRemoved)</span> entfernt</span>
                    <span><strong>@Fmt.Integer(Model.Stats.WordsChanged)</strong> ersetzt</span>
                    <span class="mat-muted">in @Fmt.Integer(Model.Stats.ParagraphsChanged) Absätzen</span>
                </div>
                <div class="mat-row">
                    <button type="button" class="mat-btn mat-btn--ghost mat-btn--sm" data-diff-step="-1">@Ui.Icon("arrow-up")<span>Vorige Änderung</span></button>
                    <button type="button" class="mat-btn mat-btn--ghost mat-btn--sm" data-diff-step="1">@Ui.Icon("arrow-down")<span>Nächste Änderung</span></button>
                </div>
            </div>
        </div>

        @if (!Model.Stats.HasChanges)
        {
            <div class="mat-empty"><span class="mat-empty__icon">@Ui.Icon("check-circle")</span><div class="mat-empty__title">Keine Unterschiede</div><p>Der Text ist wie das Original.</p></div>
        }
        else
        {
            @DiffView.Render(Model.Items, mode == "changes", "Original", $"Fassung {Model.Version.VersionNo}")
        }
    }
    else
    {
        <div class="mat-card">
            <div class="mat-card__body kk-reading">
                @for (var i = 0; i < Model.PageParagraphs.Length; i++)
                {
                    var no = Model.FirstParagraph + i + 1;
                    if (Model.PageParagraphs[i].Length == 0) { <p class="kk-reading__gap" id="p@no">&nbsp;</p> }
                    else { <p id="p@no"><span class="kk-reading__no" aria-hidden="true">@no</span>@Html.Raw(KommaKorrektus.Pages.Documents.VersionModel.Html(Model.PageParagraphs[i]))</p> }
                }
            </div>
        </div>
    }

    <partial name="_Pager" model="Model.Pager" />

    @if (link.AllowDownload)
    {
        <kk-card title="Herunterladen" icon="download">
            <div class="mat-actions">
                @if (Model.HasChanges)
                {
                    <a class="mat-btn mat-btn--primary" href="/s/@token/download/@doc.Id?format=@nameof(ExportFormat.DocxTracked)">@Ui.Icon("download")<span>Word mit Änderungen</span></a>
                    <a class="mat-btn mat-btn--secondary" href="/s/@token/download/@doc.Id?format=@nameof(ExportFormat.PdfChanges)">@Ui.Icon("download")<span>PDF mit Änderungen</span></a>
                }
                <a class="mat-btn @(Model.HasChanges ? "mat-btn--secondary" : "mat-btn--primary")" href="/s/@token/download/@doc.Id?format=@nameof(ExportFormat.DocxClean)">@Ui.Icon("download")<span>Word (sauber)</span></a>
                <a class="mat-btn mat-btn--secondary" href="/s/@token/download/@doc.Id?format=@nameof(ExportFormat.PdfClean)">@Ui.Icon("download")<span>PDF (sauber)</span></a>
            </div>
            @if (Model.HasChanges)
            {
                <p class="mat-hint">„Word mit Änderungen“ zeigt jede Änderung als Überarbeitung, die du in Word einzeln annehmen oder ablehnen kannst.</p>
            }
        </kk-card>
    }

    @if (link.AllowApproval && link.ApprovedDate is null)
    {
        <kk-card title="Freigabe" icon="check-circle">
            <form class="mat-form" method="post" asp-page="/Share/Document" asp-page-handler="Approve" asp-route-token="@token" asp-route-id="@doc.Id" asp-route-mode="@Model.Mode" novalidate>
                <p class="mat-muted">Sind die Änderungen so in Ordnung? Dann gib sie hier frei. Dein Lektorat sieht, wer wann freigegeben hat.</p>
                <div class="mat-form__grid">
                    <kk-input for="Approval.Name" label="Dein Name" autocomplete="name" />
                </div>
                <div class="mat-btn-row mat-btn-row--plain">
                    <button type="submit" class="mat-btn mat-btn--primary" data-confirm="Die Änderungen jetzt freigeben?" data-confirm-ok="Freigeben">@Ui.Icon("check")<span>Passt so, freigeben</span></button>
                </div>
            </form>
        </kk-card>
    }

    @if (link.AllowComments)
    {
        <kk-card title="Anmerkungen" icon="message-square" id="comments">
            @if (Model.Comments.Count == 0)
            {
                <p class="mat-muted">Noch keine Anmerkungen. Schreibe, was dir auffällt, dein Lektorat sieht es sofort.</p>
            }
            else
            {
                <ul class="kk-comments">
                    @foreach (var c in Model.Comments)
                    {
                        <li class="kk-comment">
                            <div class="kk-comment__head"><strong>@c.AuthorName</strong><span class="mat-muted">@Fmt.Moment(c.CreateDate)@(c.Quote is null ? "" : $" · Absatz {c.ParagraphIndex + 1}")</span></div>
                            @if (c.Quote is not null)
                            {
                                <blockquote class="kk-comment__quote">@c.Quote</blockquote>
                            }
                            <p class="kk-comment__text">@c.Text</p>
                        </li>
                    }
                </ul>
            }

            @if (Model.CanComment)
            {
                <form class="mat-form" method="post" asp-page="/Share/Document" asp-page-handler="Comment" asp-route-token="@token" asp-route-id="@doc.Id" asp-route-mode="@Model.Mode" novalidate>
                    <kk-summary />
                    <div class="mat-form__grid">
                        <kk-input for="Input.Name" label="Dein Name" autocomplete="name" required="true" />
                        <kk-input for="Input.Paragraph" label="Absatz (Nummer, optional)" type="number" min="1" hint="Die Zahl links vom Absatz im Text." />
                        <kk-textarea for="Input.Text" label="Anmerkung" rows="4" full="true" required="true" />
                    </div>
                    <div class="mat-btn-row mat-btn-row--plain">
                        <button type="submit" class="mat-btn mat-btn--primary">@Ui.Icon("send")<span>Anmerkung senden</span></button>
                    </div>
                </form>
            }
        </kk-card>
    }

    @if (Model.IsStaffPreview)
    {
        <p class="mat-hint">Du bist angemeldet: Dein Besuch wird nicht als Aufruf des Gegenübers gezählt.</p>
    }
}

@section Scripts {
    <script src="~/js/diff.js" asp-append-version="true"></script>
}
