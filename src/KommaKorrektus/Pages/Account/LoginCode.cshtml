@page
@model KommaKorrektus.Pages.Account.LoginCodeModel
@{
    Layout = "_Bare";
}

<div class="mat-auth__card">
    <div class="mat-auth__brand">
        @Ui.Logo("lg")
        <h1>Anmelden mit E-Mail-Code</h1>
        <p class="mat-muted">Ohne Passwort: Du bekommst einen Code per E-Mail.</p>
    </div>

    @if (Model.Flow is null)
    {
        <form class="mat-form" method="post" asp-page-handler="Request" novalidate>
            <input type="hidden" name="ReturnUrl" value="@Model.ReturnUrl" />
            <kk-summary title="Das hat nicht geklappt." />
            <kk-input for="Email" label="E-Mail-Adresse" type="email" autocomplete="username" inputmode="email" autofocus />
            <div class="mat-btn-row mat-btn-row--plain">
                <button type="submit" class="mat-btn mat-btn--primary mat-btn--block">@Ui.Icon("send")<span>Code senden</span></button>
            </div>
        </form>
    }
    else
    {
        <form class="mat-form" method="post" asp-page-handler="Verify" novalidate>
            <input type="hidden" name="Flow" value="@Model.Flow" />
            <input type="hidden" name="ReturnUrl" value="@Model.ReturnUrl" />
            <div class="mat-alert mat-alert--info">@Ui.Icon("info")<div class="mat-alert__body">Wenn die Adresse@(Model.ShownEmail is null ? "" : " " + Model.ShownEmail) zu einem Konto gehört, ist jetzt ein Code unterwegs. Er ist wenige Minuten gültig.</div></div>
            <kk-summary title="Das hat nicht geklappt." />
            <kk-input for="Code" label="Code aus der E-Mail" type="text" inputmode="numeric" autocomplete="one-time-code" maxlength="6" autofocus />
            <div class="mat-btn-row mat-btn-row--plain">
                <button type="submit" class="mat-btn mat-btn--primary mat-btn--block">@Ui.Icon("login")<span>Anmelden</span></button>
            </div>
        </form>
        <p class="kk-auth__alt"><a href="/Account/LoginCode">Neuen Code anfordern</a></p>
    }

    <p class="kk-auth__alt"><a href="/Account/Login">Mit Passwort anmelden</a></p>
</div>
