@page
@using Microsoft.AspNetCore.Mvc.Rendering
@model KommaKorrektus.Pages.Account.RegisterModel
@{
    Layout = "_Bare";
}

<div class="mat-auth__card">
    <div class="mat-auth__brand">
        @Ui.Logo("lg")
        <h1>Einladung</h1>
        @if (Model.Check.State == InvitationState.Valid)
        {
            <p class="mat-muted">@(Model.Check.Invitation!.Customer is { } c ? $"Zugang zu den Projekten von {c.DisplayName}" : "Dein Zugang zu KommaKorrektus")</p>
        }
    </div>

    @if (Model.Check.State != InvitationState.Valid)
    {
        <div class="mat-alert mat-alert--warning">@Ui.Icon("alert")<div class="mat-alert__body">
            @switch (Model.Check.State)
            {
                case InvitationState.Expired: <text>Diese Einladung ist abgelaufen. Bitte bitte um eine neue.</text> break;
                case InvitationState.Revoked: <text>Diese Einladung wurde zurückgezogen.</text> break;
                case InvitationState.Accepted: <text>Diese Einladung wurde schon benutzt. Melde dich einfach an.</text> break;
                default: <text>Diese Einladung kennen wir nicht. Prüfe den Link aus der E-Mail.</text> break;
            }
        </div></div>
        <div class="mat-btn-row mat-btn-row--plain">
            <a class="mat-btn mat-btn--primary mat-btn--block" href="/Account/Login">@Ui.Icon("login")<span>Zur Anmeldung</span></a>
        </div>
    }
    else if (Model.ExistingAccount)
    {
        <p>Zu <strong>@Model.Check.Invitation!.Email</strong> gibt es schon ein Konto.</p>
        @if (Model.SignedInAsInvitee)
        {
            <form method="post" novalidate>
                <input type="hidden" name="Token" value="@Model.Token" />
                <div class="mat-btn-row mat-btn-row--plain">
                    <button type="submit" class="mat-btn mat-btn--primary mat-btn--block">@Ui.Icon("check")<span>Zugriff annehmen</span></button>
                </div>
            </form>
        }
        else
        {
            <p class="mat-muted">Melde dich mit diesem Konto an. Danach kannst du die Einladung annehmen.</p>
            <div class="mat-btn-row mat-btn-row--plain">
                <a class="mat-btn mat-btn--primary mat-btn--block" href="/Account/Login?returnUrl=@Uri.EscapeDataString("/Account/Register?token=" + Model.Token)">@Ui.Icon("login")<span>Anmelden</span></a>
            </div>
        }
    }
    else
    {
        var methods = new List<SelectListItem> { new("Mit Passwort", "password"), new("Ohne Passwort: Code per E-Mail", "code") };
        <form class="mat-form" method="post" novalidate>
            <input type="hidden" name="Token" value="@Model.Token" />
            <kk-summary title="Bitte prüfe die Angaben." />
            <div class="mat-field">
                <span class="mat-label">E-Mail-Adresse</span>
                <input class="mat-input" value="@Model.Check.Invitation!.Email" disabled />
            </div>
            <kk-input for="Input.DisplayName" label="Dein Name" autocomplete="name" autofocus />
            @if (Model.CodeAvailable)
            {
                <kk-radios for="Input.Method" label="So meldest du dich an" items="methods" />
            }
            else
            {
                <input type="hidden" name="Input.Method" value="password" />
            }
            <kk-input for="Input.Password" label="Passwort" type="password" autocomplete="new-password" hint="Mindestens 10 Zeichen." show-if="@(Model.CodeAvailable ? "Input.Method" : null)" show-value="password" />
            <kk-input for="Input.PasswordRepeat" label="Passwort wiederholen" type="password" autocomplete="new-password" show-if="@(Model.CodeAvailable ? "Input.Method" : null)" show-value="password" />
            <div class="mat-btn-row mat-btn-row--plain">
                <button type="submit" class="mat-btn mat-btn--primary mat-btn--block">@Ui.Icon("user-plus")<span>Registrieren</span></button>
            </div>
        </form>
    }
</div>
