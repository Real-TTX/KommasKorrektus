@page
@model KommaKorrektus.Pages.Documents.EditorModel
@{
    var d = Model.Document;
}

<div class="kk-editor" id="kk-editor">
    @Html.AntiForgeryToken()
    <script type="application/json" id="editor-data">@Html.Raw(Model.DataJson)</script>

    <div class="kk-editor__bar mat-card">
        <div class="kk-editor__title">
            <h1>@d.Title</h1>
            <p class="mat-muted"><a href="/Projects/Details?id=@d.ProjectId&tab=documents">@d.Project!.Title</a> · <span id="editor-version">Fassung @Model.Version.VersionNo</span> · <span id="editor-words">0</span> Wörter</p>
        </div>
        <div class="kk-editor__state">
            <span id="editor-status" class="kk-editor__status is-saved" aria-live="polite" role="status">Geöffnet</span>
            <small class="mat-muted" id="editor-session"></small>
        </div>
        <div class="kk-editor__actions">
            <button type="button" class="mat-btn mat-btn--primary" id="editor-save" data-tip="Fassung speichern (Strg+S)">@Ui.Icon("save")<span>Speichern</span></button>
            <button type="button" class="mat-btn mat-btn--secondary" id="editor-name">@Ui.Icon("tag")<span>Fassung benennen</span></button>
            <button type="button" class="mat-btn mat-btn--ghost mat-btn--icon" id="editor-undo" aria-label="Rückgängig (Strg+Z)" data-tip="Rückgängig" disabled>@Ui.Icon("undo")</button>
            <button type="button" class="mat-btn mat-btn--ghost mat-btn--icon" id="editor-redo" aria-label="Wiederholen (Strg+Y)" data-tip="Wiederholen" disabled>@Ui.Icon("redo")</button>
            <button type="button" class="mat-btn mat-btn--ghost mat-btn--icon" id="editor-find" aria-label="Suchen und ersetzen (Strg+H)" data-tip="Suchen und ersetzen">@Ui.Icon("search")</button>
            <button type="button" class="mat-btn mat-btn--ghost mat-btn--icon" id="editor-side-toggle" aria-pressed="false" aria-label="Kommentare und Stilblatt" data-tip="Kommentare und Stilblatt">@Ui.Icon("message-square")<span class="mat-badge mat-badge--soft" id="comment-count">0</span></button>
            <a class="mat-btn mat-btn--ghost mat-btn--icon" href="/Documents/Compare?id=@d.Id&from=@(Math.Max(1, d.CurrentVersionNo - 1))&to=@d.CurrentVersionNo" aria-label="Änderungen ansehen" data-tip="Änderungen ansehen">@Ui.Icon("columns")</a>
            <a class="mat-btn mat-btn--ghost mat-btn--icon" href="/Documents/Details?id=@d.Id" aria-label="Zur Dokumentseite" data-tip="Fassungen und Export">@Ui.Icon("history")</a>
        </div>
    </div>

    <div class="kk-editor__body">
        <div class="kk-editor__paper" id="paras" aria-label="Text des Dokuments"></div>
        <aside class="kk-editor__side" id="editor-side" aria-label="Kommentare und Stilblatt" hidden>
            <section>
                <h2>Kommentare</h2>
                <ul class="kk-comments" id="comment-list"></ul>
            </section>
            <section>
                <h2>Stilblatt</h2>
                <ul class="kk-comments" id="style-list"></ul>
                <a class="mat-btn mat-btn--ghost mat-btn--sm" href="/Projects/Style?projectId=@d.ProjectId">@Ui.Icon("plus")<span>Eintrag</span></a>
            </section>
        </aside>
    </div>

    <dialog class="mat-dialog mat-dialog--sm" id="editor-replace" aria-labelledby="replace-title">
        <div class="mat-dialog__form">
            <div class="mat-dialog__head">@Ui.Icon("search")<h2 class="mat-dialog__title" id="replace-title">Suchen und ersetzen</h2><button type="button" class="mat-btn mat-btn--ghost mat-btn--icon mat-dialog__close" data-dialog-close aria-label="Schließen">@Ui.Icon("x")</button></div>
            <div class="mat-dialog__body mat-form">
                <div class="mat-field"><label class="mat-label" for="replace-find">Suchen</label><input class="mat-input" id="replace-find" autocomplete="off" /></div>
                <div class="mat-field"><label class="mat-label" for="replace-with">Ersetzen durch</label><input class="mat-input" id="replace-with" autocomplete="off" /></div>
                <label class="mat-switch"><input type="checkbox" id="replace-case" /><span class="mat-switch__track"></span><span>Groß- und Kleinschreibung beachten</span></label>
                <label class="mat-switch"><input type="checkbox" id="replace-whole" /><span class="mat-switch__track"></span><span>Nur ganze Wörter</span></label>
                <p class="mat-hint" id="replace-info" aria-live="polite"></p>
            </div>
            <div class="mat-dialog__foot">
                <div class="mat-btn-row mat-btn-row--plain">
                    <button type="button" class="mat-btn mat-btn--primary" id="replace-next">@Ui.Icon("search")<span>Weitersuchen</span></button>
                    <button type="button" class="mat-btn mat-btn--secondary" id="replace-one">Ersetzen</button>
                    <button type="button" class="mat-btn mat-btn--secondary" id="replace-all">Alle ersetzen</button>
                    <span class="mat-btn-row__spacer"></span>
                    <button type="button" class="mat-btn mat-btn--ghost mat-btn--end" data-dialog-close>Schließen</button>
                </div>
            </div>
        </div>
    </dialog>

    <dialog class="mat-dialog mat-dialog--sm" id="editor-comment" aria-labelledby="comment-title">
        <div class="mat-dialog__form">
            <div class="mat-dialog__head">@Ui.Icon("message-square")<h2 class="mat-dialog__title" id="comment-title">Kommentar</h2><button type="button" class="mat-btn mat-btn--ghost mat-btn--icon mat-dialog__close" data-dialog-close aria-label="Schließen">@Ui.Icon("x")</button></div>
            <div class="mat-dialog__body mat-form">
                <p class="mat-muted" id="comment-for"></p>
                <div class="mat-field"><label class="mat-label" for="comment-text">Dein Kommentar</label><textarea class="mat-textarea" id="comment-text" rows="4"></textarea></div>
            </div>
            <div class="mat-dialog__foot">
                <div class="mat-btn-row mat-btn-row--plain">
                    <button type="button" class="mat-btn mat-btn--primary" id="comment-save">@Ui.Icon("check")<span>Speichern</span></button>
                    <button type="button" class="mat-btn mat-btn--secondary" data-dialog-close>Abbrechen</button>
                </div>
            </div>
        </div>
    </dialog>
</div>

@section Scripts {
    <script src="~/js/editor.js" asp-append-version="true"></script>
}
