@page
@model KommaKorrektus.Pages.Documents.VersionModel
@{
    var link = $"/Documents/Version?id={Model.Document.Id}&no={Model.Version.VersionNo}";
}

<div class="mat-row mat-row--between kk-share__bar">
    <span></span>
    <div class="mat-seg" role="group" aria-label="Ansicht">
        <a class="mat-seg__btn" href="@link" aria-pressed="@(Model.PageView ? "false" : "true")">@Ui.Icon("type")<span>Text</span></a>
        <a class="mat-seg__btn" href="@link&view=page" aria-pressed="@(Model.PageView ? "true" : "false")" data-tip="Die Seite in der Formatierung des Originals">@Ui.Icon("file")<span>Seite</span></a>
    </div>
</div>

@if (Model.PageView && Model.Sheet is { } sheet)
{
    @LayoutView.Render(sheet, Model.PageItems, withNotes: Model.Pager.Page >= (int)Math.Ceiling(Model.Pager.Total / (double)Model.Pager.PageSize))
    if (!sheet.Formatted)
    {
        <p class="mat-hint">Das Original ist keine Word-Datei (oder sein Text ist nicht mehr der des Imports): Die Seite zeigt den Text einfach, ohne Formatierung.</p>
    }

    <partial name="_Pager" model="Model.Pager" />
}
else
{
    <div class="mat-card">
        <div class="mat-card__body kk-reading">
            @for (var i = 0; i < Model.Paragraphs.Length; i++)
            {
                if (Model.Paragraphs[i].Length == 0) { <p class="kk-reading__gap" id="p@(i + 1)">&nbsp;</p> }
                else { <p id="p@(i + 1)">@Html.Raw(KommaKorrektus.Pages.Documents.VersionModel.Html(Model.Paragraphs[i]))</p> }
            }
        </div>
    </div>
}

<div class="mat-actions">
    <a class="mat-btn mat-btn--primary" href="/Documents/Compare?id=@Model.Document.Id&from=@(Math.Max(1, Model.Version.VersionNo - 1))&to=@Model.Version.VersionNo">@Ui.Icon("columns")<span>Mit der Fassung davor vergleichen</span></a>
    <a class="mat-btn mat-btn--secondary" href="/Documents/Export?id=@Model.Document.Id&from=@Model.Version.VersionNo&to=@Model.Version.VersionNo&format=@nameof(ExportFormat.PdfClean)">@Ui.Icon("download")<span>Als PDF</span></a>
    <a class="mat-btn mat-btn--secondary" href="/Documents/Details?id=@Model.Document.Id&tab=versions">@Ui.Icon("back")<span>Zurück</span></a>
</div>

@section Scripts {
    <script src="~/js/sheet.js" asp-append-version="true"></script>
}
