@inject IconSprite Sprite
@model (ShellModel Shell, string Title)
@*
    The <head> of every page: the toolkit (copied into wwwroot/ui, never loaded from another site), the boot script that applies the saved theme before
    the first paint, and the few styles of the app itself.
*@
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="color-scheme" content="light dark" />
    <meta name="theme-color" content="#a43bd0" />
    <meta name="robots" content="noindex, nofollow" />
    <title>@Model.Title · KommaKorrektus</title>
    <link rel="icon" type="image/svg+xml" href="~/favicon.svg" />
    <script src="~/ui/matui.boot.js?v=@Sprite.Hash"></script>
    <link rel="stylesheet" href="~/ui/matui.css?v=@Sprite.Hash" />
    <link rel="stylesheet" href="~/css/app.css" asp-append-version="true" />
</head>
