@page
@model KommaKorrektus.Pages.Portal.ProjectModel
@{
    var p = Model.Project;
}

<div class="mat-grid mat-grid--3">
    <div class="mat-card"><div class="mat-card__body mat-stat"><span class="mat-stat__label">Stand</span><span class="mat-stat__value kk-stat-pill">@Labels.Pill(p.Status)</span><span class="mat-stat__delta">@Labels.Of(p.ServiceType)</span></div></div>
    <div class="mat-card"><div class="mat-card__body mat-stat"><span class="mat-stat__label">Frist</span><span class="mat-stat__value">@(p.DueDate is null ? "–" : Fmt.Date(p.DueDate))</span><span class="mat-stat__delta">@(p.DoneDate is not null ? "abgeschlossen am " + Fmt.Date(p.DoneDate) : p.StartDate is not null ? "Beginn " + Fmt.Date(p.StartDate) : "")</span></div></div>
    <div class="mat-card"><div class="mat-card__body mat-stat"><span class="mat-stat__label">Dokumente</span><span class="mat-stat__value">@Model.Documents.Count</span><span class="mat-stat__delta">@(string.IsNullOrWhiteSpace(p.Genre) ? p.Number : p.Genre)</span></div></div>
</div>

@if (!string.IsNullOrWhiteSpace(p.Description))
{
    <kk-card title="Über das Projekt" icon="book"><p class="kk-prewrap">@p.Description</p></kk-card>
}

<kk-card title="Dokumente" icon="file-text">
    @if (Model.Documents.Count == 0)
    {
        <p class="mat-muted">In diesem Projekt gibt es noch kein Dokument.</p>
    }
    else
    {
        <div class="mat-table-wrap">
            <table class="mat-table" id="portal-documents">
                <caption class="mat-sr-only">Dokumente des Projekts</caption>
                <thead><tr><th scope="col">Dokument</th><th scope="col" class="mat-hide-sm">Fassung</th><th scope="col" class="mat-num mat-hide-sm">Wörter</th><th scope="col" class="mat-hide-sm">Stand</th><th scope="col" class="mat-col-actions"><span class="mat-sr-only">Aktionen</span></th></tr></thead>
                <tbody>
                    @foreach (var row in Model.Documents)
                    {
                        <tr>
                            <td data-label="Dokument"><a href="/Portal/Document?id=@row.Document.Id">@row.Document.Title</a></td>
                            <td data-label="Fassung" class="mat-hide-sm">@row.Document.CurrentVersionNo</td>
                            <td data-label="Wörter" class="mat-num mat-hide-sm">@Fmt.Integer(row.Words)</td>
                            <td data-label="Stand" class="mat-hide-sm">@Fmt.Date(row.Changed)</td>
                            <td class="mat-col-actions"><a class="mat-btn mat-btn--secondary mat-btn--sm" href="/Portal/Document?id=@row.Document.Id">@Ui.Icon("eye")<span>Ansehen</span></a></td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</kk-card>

@if (Model.Invoices.Count > 0)
{
    <kk-card title="Rechnungen und Angebote" icon="dollar">
        <div class="mat-table-wrap">
            <table class="mat-table" id="portal-project-invoices">
                <caption class="mat-sr-only">Rechnungen und Angebote des Projekts</caption>
                <thead><tr><th scope="col">Nummer</th><th scope="col" class="mat-hide-sm">Datum</th><th scope="col" class="mat-num">Betrag</th><th scope="col">Status</th><th scope="col" class="mat-col-actions"><span class="mat-sr-only">Aktionen</span></th></tr></thead>
                <tbody>
                    @foreach (var i in Model.Invoices)
                    {
                        <tr>
                            <td data-label="Nummer" class="mat-mono">@i.Number</td>
                            <td data-label="Datum" class="mat-hide-sm">@Fmt.Date(i.IssueDate)</td>
                            <td data-label="Betrag" class="mat-num">@Fmt.Money(i.GrossTotal, i.Currency)</td>
                            <td data-label="Status">@Labels.Pill(i.Status, i.Type)</td>
                            <td class="mat-col-actions"><a class="mat-btn mat-btn--secondary mat-btn--sm" href="/Portal/InvoiceFile?id=@i.Id">@Ui.Icon("download")<span>PDF</span></a></td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </kk-card>
}

<div class="mat-actions">
    <a class="mat-btn mat-btn--secondary" href="/Portal">@Ui.Icon("back")<span>Alle Projekte</span></a>
</div>
