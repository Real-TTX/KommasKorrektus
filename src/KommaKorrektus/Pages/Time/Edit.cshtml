@page
@model KommaKorrektus.Pages.Time.EditModel

<form class="mat-form" method="post" novalidate>
    <input type="hidden" name="Id" value="@Model.Id" />
    <kk-summary />
    @if (Model.Billed)
    {
        <div class="mat-alert mat-alert--info">@Ui.Icon("info")<div class="mat-alert__body">Diese Zeit ist schon abgerechnet und kann nicht mehr geändert werden.</div></div>
    }
    <kk-card title="Arbeitszeit" icon="clock">
        <div class="mat-form__grid">
            <kk-select for="Input.ProjectId" label="Projekt" items="Model.Projects" empty="Bitte wählen ..." full="true" required="true" disabled="@Model.Billed" />
            <kk-input for="Input.Day" label="Tag" type="date" required="true" />
            <kk-input for="Input.StartTime" label="Beginn (Uhrzeit)" type="time" hint="Leer: 09:00." />
            <kk-input for="Input.Duration" label="Dauer" required="true" hint="Zum Beispiel 1:30, 90 Minuten oder 1,5 Stunden." />
            <kk-input for="Input.Note" label="Notiz" full="true" />
            <kk-switch for="Input.IsBillable" label="Abrechenbar" full="true" />
        </div>
    </kk-card>
    @if (Model.Id is not null && !Model.Billed)
    {
        <kk-buttons back-href="/Time" delete-url="@Url.Page("/Time/Edit", "Delete", new { id = Model.Id })" delete-confirm="Diese Zeit löschen?" />
    }
    else
    {
        <kk-buttons back-href="/Time" no-save="@Model.Billed" />
    }
</form>
