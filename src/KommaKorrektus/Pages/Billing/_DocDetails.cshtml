@using KommaKorrektus.Core.Billing
@using KommaKorrektus.Pages.Billing
@model DocDetailsModelBase
@{
    var i = Model.Invoice;
    var isOffer = i.Type == DocType.Offer;
    var isInvoice = i.Type == DocType.Invoice;
    var canPay = isInvoice && i.Status is DocStatus.Issued or DocStatus.PartiallyPaid;
}

<div class="mat-grid mat-grid--4">
    <div class="mat-card"><div class="mat-card__body mat-stat"><span class="mat-stat__label">Status</span><span class="mat-stat__value kk-stat-pill">@Ui.Pill(Model.StatusText, Model.StatusTone)</span><span class="mat-stat__delta">@(isOffer ? "Gültig bis " + Fmt.Date(i.ValidUntil) : i.DueDate is null ? "" : "Fällig " + Fmt.Date(i.DueDate))</span></div></div>
    <div class="mat-card"><div class="mat-card__body mat-stat"><span class="mat-stat__label">@(i.SmallBusiness ? "Betrag" : "Brutto")</span><span class="mat-stat__value">@Fmt.Money(i.GrossTotal, i.Currency)</span><span class="mat-stat__delta">@(i.SmallBusiness ? "ohne Umsatzsteuer (§ 19 UStG)" : $"netto {Fmt.Money(i.NetTotal, i.Currency)}")</span></div></div>
    @if (isInvoice)
    {
        <div class="mat-card"><div class="mat-card__body mat-stat"><span class="mat-stat__label">Bezahlt</span><span class="mat-stat__value">@Fmt.Money(i.PaidTotal, i.Currency)</span><span class="mat-stat__delta">@(i.PaidDate is null ? "" : "am " + Fmt.Date(i.PaidDate))</span></div></div>
        <div class="mat-card"><div class="mat-card__body mat-stat"><span class="mat-stat__label">Offen</span><span class="mat-stat__value">@Fmt.Money(Model.Open, i.Currency)</span><span class="mat-stat__delta @(Model.Overdue ? "kk-warn" : "")">@(Model.Overdue ? "überfällig" : "")</span></div></div>
    }
    else
    {
        <div class="mat-card"><div class="mat-card__body mat-stat"><span class="mat-stat__label">Datum</span><span class="mat-stat__value">@Fmt.Date(i.IssueDate)</span><span class="mat-stat__delta">@(i.SentDate is null ? "noch nicht versendet" : "versendet " + Fmt.Date(i.SentDate))</span></div></div>
    }
</div>

@if (Model.Source is { } source)
{
    <div class="mat-alert mat-alert--info">@Ui.Icon("link")<div class="mat-alert__body">@(i.Type == DocType.CreditNote ? "Gutschrift zu" : "Entstanden aus") <a href="@(source.Type == DocType.Offer ? "/Offers" : "/Invoices")/Details?id=@source.Id">@Labels.Of(source.Type) @source.Number</a>.</div></div>
}
@foreach (var d in Model.Derived)
{
    <div class="mat-alert mat-alert--info">@Ui.Icon("link")<div class="mat-alert__body">@(d.Type == DocType.CreditNote ? "Storniert durch" : "Daraus ist entstanden:") <a href="@(d.Type == DocType.Offer ? "/Offers" : "/Invoices")/Details?id=@d.Id">@Labels.Of(d.Type) @(d.Number ?? "(Entwurf)")</a>.</div></div>
}
@if (!isOffer && !Model.HasEInvoice && Model.EInvoiceProblems.Count > 0)
{
    <div class="mat-alert mat-alert--warning">@Ui.Icon("alert")<div class="mat-alert__body"><strong>Dieses PDF enthält keine E-Rechnung.</strong> Es fehlt: @string.Join(" ", Model.EInvoiceProblems)</div></div>
}

<kk-tabs id="doc" label="Dokument" selected="@Model.Tab">
    <kk-tab id="overview" title="Übersicht" icon="file-text">
        <div class="mat-card">
            <div class="mat-card__body">
                @if (!string.IsNullOrWhiteSpace(i.Subject)) { <p><strong>@i.Subject</strong></p> }
                <div class="mat-table-wrap">
                    <table class="mat-table" id="doc-lines">
                        <caption class="mat-sr-only">Positionen</caption>
                        <thead><tr><th scope="col" class="mat-num">Pos.</th><th scope="col">Leistung</th><th scope="col" class="mat-num mat-hide-sm">Menge</th><th scope="col" class="mat-num mat-hide-sm">Einzelpreis</th><th scope="col" class="mat-num mat-hide-sm">USt.</th><th scope="col" class="mat-num">Betrag</th></tr></thead>
                        <tbody>
                            @foreach (var l in i.Lines.OrderBy(l => l.Position))
                            {
                                <tr>
                                    <td data-label="Pos." class="mat-num">@l.Position</td>
                                    <td data-label="Leistung"><div class="mat-table__name kk-name"><span>@l.Title</span>@if (!string.IsNullOrWhiteSpace(l.Description)) { <small class="mat-muted kk-sub">@l.Description</small> }</div></td>
                                    <td data-label="Menge" class="mat-num mat-hide-sm">@Fmt.Number(l.Quantity, l.Quantity % 1 == 0 ? 0 : 2) @l.Unit</td>
                                    <td data-label="Einzelpreis" class="mat-num mat-hide-sm">@Fmt.Money(l.UnitPrice, i.Currency)</td>
                                    <td data-label="USt." class="mat-num mat-hide-sm">@(i.SmallBusiness ? "–" : Fmt.Number(i.ReverseCharge ? 0 : l.VatRate, 0) + " %")</td>
                                    <td data-label="Betrag" class="mat-num">@Fmt.Money(l.NetAmount, i.Currency)</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
                <div class="kk-totals">
                    @if (i.DiscountPercent != 0) { <div class="kk-totals__row"><span>Rabatt @Fmt.Number(i.DiscountPercent, 0) %</span><span></span></div> }
                    <div class="kk-totals__row"><span>@(i.SmallBusiness ? "Gesamtbetrag" : "Nettobetrag")</span><span>@Fmt.Money(i.NetTotal, i.Currency)</span></div>
                    @if (!i.SmallBusiness) { <div class="kk-totals__row"><span>Umsatzsteuer</span><span>@Fmt.Money(i.VatTotal, i.Currency)</span></div> <div class="kk-totals__row kk-totals__row--gross"><span>Gesamtbetrag</span><span>@Fmt.Money(i.GrossTotal, i.Currency)</span></div> }
                </div>
            </div>
        </div>
        <div class="mat-grid mat-grid--2">
            <kk-card title="Dokument" icon="info">
                <dl class="mat-kv">
                    <dt>Nummer</dt><dd class="mat-mono">@i.Number</dd>
                    <dt>Datum</dt><dd>@Fmt.Date(i.IssueDate)</dd>
                    @if (i.ServiceFrom is not null || i.ServiceTo is not null) { <dt>Leistung</dt><dd>@GermanFormat.Period(i.ServiceFrom, i.ServiceTo)</dd> }
                    @if (isInvoice) { <dt>Zahlungsziel</dt><dd>@i.PaymentTermDays Tage, fällig am @Fmt.Date(i.DueDate)</dd> }
                    <dt>Kunde</dt><dd><a href="/Customers/Details?id=@Model.Customer.Id">@Model.Customer.DisplayName</a></dd>
                    @if (Model.ProjectTitle is not null) { <dt>Projekt</dt><dd><a href="/Projects/Details?id=@i.ProjectId">@Model.ProjectTitle</a></dd> }
                    @if (!string.IsNullOrWhiteSpace(i.CustomerReference)) { <dt>Referenz des Kunden</dt><dd>@i.CustomerReference</dd> }
                    @if (!string.IsNullOrWhiteSpace(i.BuyerReference)) { <dt>Leitweg-ID</dt><dd class="mat-mono">@i.BuyerReference</dd> }
                </dl>
            </kk-card>
            @if (!string.IsNullOrWhiteSpace(i.InternalNote))
            {
                <kk-card title="Interne Notiz" icon="edit"><p class="kk-prewrap">@i.InternalNote</p></kk-card>
            }
        </div>
    </kk-tab>

    <kk-tab id="pdf" title="PDF" icon="eye">
        <div class="mat-card"><div class="mat-card__body kk-preview"><iframe class="kk-preview__frame" title="Das ausgestellte Dokument als PDF" src="@Model.Base/Download?id=@i.Id&inline=true"></iframe></div></div>
    </kk-tab>

    @if (isInvoice)
    {
        <kk-tab id="payments" title="Zahlungen" icon="dollar" count="@Model.Payments.Count">
            @if (Model.Payments.Count == 0)
            {
                <div class="mat-empty"><span class="mat-empty__icon">@Ui.Icon("dollar")</span><div class="mat-empty__title">Noch keine Zahlung</div><p>Trage den Zahlungseingang ein, sobald das Geld da ist.</p></div>
            }
            else
            {
                <div class="mat-table-wrap">
                    <table class="mat-table" id="doc-payments">
                        <caption class="mat-sr-only">Zahlungen</caption>
                        <thead><tr><th scope="col">Datum</th><th scope="col" class="mat-num">Betrag</th><th scope="col" class="mat-hide-sm">Art</th><th scope="col" class="mat-hide-sm">Verwendungszweck</th><th scope="col"><span class="mat-sr-only">Aktionen</span></th></tr></thead>
                        <tbody>
                            @foreach (var p in Model.Payments)
                            {
                                <tr>
                                    <td data-label="Datum">@Fmt.Date(p.PaidDate)</td>
                                    <td data-label="Betrag" class="mat-num">@Fmt.Money(p.Amount, i.Currency)</td>
                                    <td data-label="Art" class="mat-hide-sm">@Labels.Of(p.Method)</td>
                                    <td data-label="Verwendungszweck" class="mat-hide-sm">@p.Reference</td>
                                    <td class="mat-table__cell-actions">
                                        <form method="post" asp-page-handler="RemovePayment" asp-route-id="@i.Id" asp-route-paymentId="@p.Id" class="mat-table__actions">
                                            <button type="submit" class="mat-btn mat-btn--ghost mat-btn--icon mat-btn--sm" aria-label="Zahlung entfernen" data-tip="Entfernen" data-confirm="Diese Zahlung entfernen?" data-confirm-ok="Entfernen">@Ui.Icon("trash")</button>
                                        </form>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            @if (canPay)
            {
                <div class="mat-actions"><a class="mat-btn mat-btn--primary" href="/Invoices/Payment?invoiceId=@i.Id">@Ui.Icon("plus")<span>Zahlung eintragen</span></a></div>
            }
        </kk-tab>
    }
</kk-tabs>

<form method="post" class="mat-actions kk-doc-actions">
    <a class="mat-btn mat-btn--primary" href="@Model.Base/Download?id=@i.Id">@Ui.Icon("download")<span>PDF</span></a>
    @if (!isOffer)
    {
        <a class="mat-btn mat-btn--secondary" href="@Model.Base/Download?id=@i.Id&kind=xml" data-tip="Die Rechnungsdaten als XML (ZUGFeRD / Factur-X)">@Ui.Icon("code")<span>E-Rechnung (XML)</span></a>
        <a class="mat-btn mat-btn--secondary" href="@Model.Base/Download?id=@i.Id&kind=xrechnung" data-tip="Für Behörden: XRechnung">@Ui.Icon("code")<span>XRechnung</span></a>
    }
    <a class="mat-btn mat-btn--secondary" href="@Model.Base/Send?id=@i.Id">@Ui.Icon("send")<span>Per E-Mail senden</span></a>
    @if (canPay) { <a class="mat-btn mat-btn--secondary" href="/Invoices/Payment?invoiceId=@i.Id">@Ui.Icon("dollar")<span>Zahlung</span></a> }
    @if (canPay && Model.Overdue) { <a class="mat-btn mat-btn--secondary" href="/Invoices/Send?id=@i.Id&reminder=true">@Ui.Icon("bell")<span>Erinnerung</span></a> }
    @if (isOffer && i.Status == DocStatus.Issued)
    {
        <button type="submit" asp-page-handler="Accept" class="mat-btn mat-btn--secondary">@Ui.Icon("check")<span>Angenommen</span></button>
        <button type="submit" asp-page-handler="Decline" class="mat-btn mat-btn--secondary">@Ui.Icon("x")<span>Abgelehnt</span></button>
    }
    @if (isOffer && i.Status is DocStatus.Issued or DocStatus.Accepted)
    {
        <button type="submit" asp-page-handler="CreateInvoice" class="mat-btn mat-btn--secondary">@Ui.Icon("receipt")<span>Rechnung erstellen</span></button>
    }
    @if (i.SentDate is null) { <button type="submit" asp-page-handler="MarkSent" class="mat-btn mat-btn--ghost">@Ui.Icon("check")<span>Als versendet markieren</span></button> }
    <button type="submit" asp-page-handler="Duplicate" class="mat-btn mat-btn--ghost">@Ui.Icon("copy")<span>Duplizieren</span></button>
    <a class="mat-btn mat-btn--secondary" href="@Model.Base">@Ui.Icon("back")<span>Zurück</span></a>
    @if (isInvoice && i.Status is not DocStatus.Cancelled and not DocStatus.Draft)
    {
        <span class="mat-btn-row__spacer"></span>
        <button type="submit" asp-page-handler="Cancel" class="mat-btn mat-btn--danger" data-confirm="Diese Rechnung stornieren? Es wird eine Gutschrift mit denselben Positionen erstellt. Die Rechnung gilt dann als storniert." data-confirm-ok="Stornieren">@Ui.Icon("restore")<span>Stornieren</span></button>
    }
</form>
