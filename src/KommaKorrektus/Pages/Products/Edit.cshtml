@page
@model KommaKorrektus.Pages.Products.EditModel
@{
    var services = Controls.Options.Of<ServiceType>(Labels.Of);
}

<form class="mat-form" method="post" novalidate>
    <input type="hidden" name="Id" value="@Model.Id" />
    <kk-summary />
    <kk-card title="Produkt" icon="tag" sub="@Model.Number">
        <div class="mat-form__grid">
            <kk-input for="Input.Name" label="Name" full="true" required="true" hint="Zum Beispiel „Lektorat“ oder „Probelektorat“." />
            <kk-textarea for="Input.Description" label="Beschreibung" rows="2" full="true" hint="Steht unter dem Namen auf dem Angebot und der Rechnung." />
            <kk-input for="Input.Unit" label="Einheit" list="units" hint="Normseite, Wort, Stunde, pauschal ..." />
            <kk-input for="Input.NetPrice" label="Preis (netto)" type="number" min="0" required="true" />
            @if (!Model.SmallBusiness)
            {
                <kk-input for="Input.VatRate" label="Umsatzsteuer in Prozent" type="number" min="0" max="30" hint="19 % normal, 7 % ermäßigt." />
            }
            <kk-input for="Input.Category" label="Kategorie" />
            <kk-select for="Input.ServiceType" label="Passt zur Leistung" items="services" empty="(keine bestimmte)" />
            <kk-switch for="Input.IsActive" label="Wird noch angeboten" full="true" />
        </div>
        <datalist id="units"><option value="Normseite"></option><option value="Wort"></option><option value="Stunde"></option><option value="pauschal"></option><option value="Tag"></option><option value="Stück"></option></datalist>
    </kk-card>
    @if (Model.Id is not null)
    {
        <kk-buttons back-href="/Products" delete-url="@Url.Page("/Products/Edit", "Delete", new { id = Model.Id })" delete-confirm="Dieses Produkt löschen? Bestehende Rechnungen bleiben unverändert." />
    }
    else
    {
        <kk-buttons back-href="/Products" />
    }
</form>
