@page
@model KommaKorrektus.Pages.Invoices.PaymentModel
@{
    var methods = Controls.Options.Of<PaymentMethod>(Labels.Of);
    var back = $"/Invoices/Details?id={Model.InvoiceId}&tab=payments";
}

<form class="mat-form" method="post" novalidate>
    <input type="hidden" name="InvoiceId" value="@Model.InvoiceId" />
    <kk-summary />
    <kk-card title="@($"Rechnung {Model.Invoice.Number}")" icon="dollar" sub="@($"offen: {Fmt.Money(Model.Open, Model.Invoice.Currency)} von {Fmt.Money(Model.Invoice.GrossTotal, Model.Invoice.Currency)}")">
        <div class="mat-form__grid">
            <kk-input for="Input.Amount" label="Betrag" type="number" required="true" hint="Eine Teilzahlung ist möglich. Der Rest bleibt offen." />
            <kk-input for="Input.Date" label="Zahlungsdatum" type="date" required="true" />
            <kk-select for="Input.Method" label="Art" items="methods" />
            <kk-input for="Input.Reference" label="Verwendungszweck" />
        </div>
    </kk-card>
    <kk-buttons back-href="@back" />
</form>
